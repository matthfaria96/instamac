+// Decoded video for a TextureView (TextureView.macapkNativeVideoFrame): the
+// CVPixelBuffer's IOSurface becomes the layer's contents as it is -- no copy, no
+// conversion, no Java. The buffer stays retained while it is on screen
+// (g_surface_pixbufs) so the decoder's pool cannot refill it under the
+// compositor; the previous one is released when the next frame replaces it.
+
+static bool MacapkPresentSurfacePixbuf(int key, void* pixbuf) {
+    CVPixelBufferRef pb = (CVPixelBufferRef) pixbuf;
+    if (!CVPixelBufferGetIOSurface(pb)) return false;   // not displayable as is
+    CFRetain(pb);
+    void (^mainBlock)(void) = ^{
+        @autoreleasepool {
+            if (!MacapkCanvasOverlayForPresent()) { CFRelease(pb); return; }
+            CALayer* layer = MacapkSurfaceLayerFor(key, (int) CVPixelBufferGetWidth(pb),
+                                                   (int) CVPixelBufferGetHeight(pb));
+            NSNumber* nk = [NSNumber numberWithInt:key];
+            if (!MacapkApplySurfaceLayerGeometry(MacapkMainThreadEnv(), nk, layer)) {
+                CFRelease(pb);
+                return;
+            }
+            layer.contents = (__bridge id) CVPixelBufferGetIOSurface(pb);
+            if (!g_surface_pixbufs) g_surface_pixbufs = [[NSMutableDictionary alloc] init];
+            g_surface_pixbufs[nk] = (__bridge id) pb;   // replaces (and releases) the previous
+            CFRelease(pb);
+        }
+    };
+    if ([NSThread isMainThread]) mainBlock();
+    else dispatch_async(dispatch_get_main_queue(), mainBlock);
+    return true;
+}
