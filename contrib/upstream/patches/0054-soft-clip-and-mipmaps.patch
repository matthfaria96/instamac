+        layer.parentImage = image;
+        layer.parentG = g;
+        layer.layerG = lg;
+        layer.layerImage = li;
+        layer.alpha = 1f;
+        layer.softMaskDev = dev;
+        layer.softX = box.x;
+        layer.softY = box.y;
