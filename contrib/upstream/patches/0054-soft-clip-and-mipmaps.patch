+        if (layerStack.isEmpty() || layerStack.peek() != NO_LAYER) return false;
+        final AffineTransform ctm = g.getTransform();
+        final java.awt.Shape dev;
+        try { dev = ctm.createTransformedShape(s); } catch (Throwable t) { return false; }
+        java.awt.Rectangle box = dev.getBounds();
+        java.awt.Shape cur = g.getClip();
+        if (cur != null) {
+            try { box = box.intersection(ctm.createTransformedShape(cur).getBounds()); } catch (Throwable t) { return false; }
+        }
+        box = box.intersection(new java.awt.Rectangle(0, 0, image.getWidth(), image.getHeight()));
+        if (box.isEmpty() || (long) box.width * box.height > SOFT_CLIP_MAX_PX) return false;
+        final BufferedImage li = new BufferedImage(box.width, box.height, BufferedImage.TYPE_INT_ARGB);
+        final Graphics2D lg = li.createGraphics();
+        macapkInitHints(lg);
+        lg.setRenderingHints(g.getRenderingHints());
+        final AffineTransform lt = AffineTransform.getTranslateInstance(-box.x, -box.y);
+        lg.setClip(new java.awt.Rectangle(0, 0, box.width, box.height));
+        lt.concatenate(ctm);
+        lg.setTransform(lt);
