     private final Map<String, String> dimenValues = new HashMap<>();
     private final Map<String, String> fractionValues = new HashMap<>();
+
+    /** MACAPK_RES_OVERRIDES="dimen/<name>=<value>;...": a value the host product
+     *  chooses over the APK's, by resource name, for every configuration (the
+     *  launcher's, e.g. Instamac's chips drawn as on the owner's phone). Only
+     *  dimens today. */
+    private static final Map<String, String> RES_OVERRIDES = parseResOverrides(
+        System.getenv("MACAPK_RES_OVERRIDES"));
+    private static Map<String, String> parseResOverrides(String spec) {
+        Map<String, String> out = new HashMap<>();
+        if (spec == null) return out;
+        for (String part : spec.split(";")) {
+            int eq = part.indexOf('=');
+            if (eq <= 0 || eq == part.length() - 1) continue;
+            String key = part.substring(0, eq).trim(), val = part.substring(eq + 1).trim();
+            if (key.startsWith("dimen/") && !val.isEmpty()) out.put(key, val);
+        }
+        return out;
+    }
