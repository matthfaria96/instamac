diff --git a/src/dex/Translator.java b/src/dex/Translator.java
--- a/src/dex/Translator.java
+++ b/src/dex/Translator.java
@@ -56,6 +56,87 @@ import java.util.Map;
 
 public final class Translator {
 
+    /** The current class's static values to store at the top of its <clinit>
+     *  ({name, descriptor, DexFile.Value}), set by DexConverter around the
+     *  class; null when there are none. */
+    static final ThreadLocal<java.util.List<Object[]>> CLINIT_STATIC_VALUES = new ThreadLocal<>();
+
+    /** True for a static value the class file cannot carry as ConstantValue
+     *  (DexConverter.boxConstant answers null) and which is not the field's
+     *  default: it has to be stored by <clinit>. */
+    static boolean storesInClinit(DexFile.Value v, String desc) {
+        if (v == null || v.isNull()) return false;
+        if (DexConverter.boxConstant(v, desc) != null) return false;
+        switch (v.tag()) {
+            case DexFile.VALUE_TYPE:
+            case DexFile.VALUE_STRING:
+            case DexFile.VALUE_ENUM:
+            case DexFile.VALUE_METHOD_TYPE:
+            case DexFile.VALUE_METHOD_HANDLE:
+                return true;
+            default:
+                return false;
+        }
+    }
+
+    /** ldc / getstatic each value and putstatic it into its field of `owner`. */
+    static void emitStaticValueStores(CodeWriter c, String owner, java.util.List<Object[]> values) {
+        ConstantPool pool = c.pool();
+        for (Object[] e : values) {
+            String name = (String) e[0], desc = (String) e[1];
+            DexFile.Value v = (DexFile.Value) e[2];
+            switch (v.tag()) {
+                case DexFile.VALUE_TYPE:
+                    c.ldcRaw(pool.classRef(DexFile.internalName(v.asTypeDescriptor())));
+                    break;
+                case DexFile.VALUE_STRING:
+                    c.ldcString(v.asString());
+                    break;
+                case DexFile.VALUE_ENUM: {
+                    DexFile.FieldRef f = v.asField();
+                    c.fieldOp(CodeWriter.GETSTATIC, DexFile.internalName(f.declaringClass()),
+                              f.name(), f.type());
+                    break;
+                }
+                case DexFile.VALUE_METHOD_TYPE:
+                    c.ldcRaw(pool.methodType(v.asProto().descriptor()));
+                    break;
+                case DexFile.VALUE_METHOD_HANDLE: {
+                    DexFile.MethodHandleRef h = v.asMethodHandle();
+                    int kind = staticValueHandleKind(h.type());
+                    if (h.field() != null) {
+                        DexFile.FieldRef f = h.field();
+                        c.ldcRaw(pool.methodHandle(kind, DexFile.internalName(f.declaringClass()),
+                                f.name(), f.type(), false));
+                    } else {
+                        DexFile.MethodRef m = h.method();
+                        c.ldcRaw(pool.methodHandle(kind, DexFile.internalName(m.declaringClass()),
+                                m.name(), m.proto().descriptor(),
+                                h.type() == DexFile.METHOD_HANDLE_INVOKE_INTERFACE));
+                    }
+                    break;
+                }
+                default:
+                    continue;
+            }
+            c.fieldOp(CodeWriter.PUTSTATIC, owner, name, desc);
+        }
+    }
+
+    private static int staticValueHandleKind(int dexType) {
+        switch (dexType) {
+            case DexFile.METHOD_HANDLE_STATIC_PUT:      return ConstantPool.REF_putStatic;
+            case DexFile.METHOD_HANDLE_STATIC_GET:      return ConstantPool.REF_getStatic;
+            case DexFile.METHOD_HANDLE_INSTANCE_PUT:    return ConstantPool.REF_putField;
+            case DexFile.METHOD_HANDLE_INSTANCE_GET:    return ConstantPool.REF_getField;
+            case DexFile.METHOD_HANDLE_INVOKE_STATIC:   return ConstantPool.REF_invokeStatic;
+            case DexFile.METHOD_HANDLE_INVOKE_INSTANCE: return ConstantPool.REF_invokeVirtual;
+            case DexFile.METHOD_HANDLE_INVOKE_CONSTRUCTOR: return ConstantPool.REF_newInvokeSpecial;
+            case DexFile.METHOD_HANDLE_INVOKE_DIRECT:   return ConstantPool.REF_invokeSpecial;
+            default:                                    return ConstantPool.REF_invokeInterface;
+        }
+    }
+
     private Translator() {}
 
