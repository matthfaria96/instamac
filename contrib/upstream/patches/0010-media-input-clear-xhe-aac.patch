+// The audioObjectType of an MPEG-4 AudioSpecificConfig (ISO/IEC 14496-3
+// 1.6.2.1): 5 bits, or the escape value 31 followed by 6 more bits (type =
+// 32 + those). 0 when the config is absent or too short to say.
+static int md_asc_object_type(const void* csd, int len) {
+    if (!csd || len < 2) return 0;
+    const uint8_t* p = (const uint8_t*)csd;
+    int aot = p[0] >> 3;
+    if (aot == 31) aot = 32 + (((p[0] & 0x07) << 3) | (p[1] >> 5));
+    return aot;
+}
+
+// csd-0 for AAC reaches the decoder in two shapes: the bare
+// AudioSpecificConfig (what an Android client hands MediaCodec) or a whole
+// ES_Descriptor (what AudioFile calls the magic cookie, and what this file's
+// own demuxer therefore reports). Point at the AudioSpecificConfig in either:
+// an ES_Descriptor starts with tag 0x03, which no config can (that would be
+// audioObjectType 0). Descriptor lengths are 1-4 bytes, 7 bits each, high bit
+// = "more" (ISO/IEC 14496-1 8.3.3).
+static bool md_asc_in_csd(const void* csd, int len, const uint8_t** asc, int* ascLen) {
+    const uint8_t* p = (const uint8_t*)csd;
+    if (!p || len < 2) return false;
+    if (p[0] != 0x03) { *asc = p; *ascLen = len; return true; }
+    const uint8_t* end = p + len;
+    auto read_len = [&](const uint8_t*& q, uint32_t& out) -> bool {
+        out = 0;
+        for (int i = 0; i < 4 && q < end; ++i) {
+            uint8_t b = *q++;
+            out = (out << 7) | (b & 0x7f);
+            if (!(b & 0x80)) return true;
+        }
+        return false;
+    };
+    const uint8_t* q = p + 1;
+    uint32_t n = 0;
+    if (!read_len(q, n) || q + 3 > end) return false;
+    const uint8_t flags = q[2];
+    q += 3;                                             // ES_ID, flags
+    if (flags & 0x80) q += 2;                           // dependsOn_ES_ID
+    if (flags & 0x40) { if (q >= end) return false; q += 1 + *q; }   // URL
+    if (flags & 0x20) q += 2;                           // OCR_ES_Id
+    if (q >= end || *q++ != 0x04) return false;         // DecoderConfigDescriptor
+    if (!read_len(q, n) || q + 13 > end) return false;
+    q += 13;
+    if (q >= end || *q++ != 0x05) return false;         // DecoderSpecificInfo
+    if (!read_len(q, n) || q + n > end || n == 0) return false;
+    *asc = q; *ascLen = (int)n;
+    return true;
+}
+
+// An MPEG-4 ES_Descriptor (ISO/IEC 14496-1 7.2.6.5) around an
+// AudioSpecificConfig: ES_Descriptor{ES_ID 1} > DecoderConfigDescriptor{
+// objectTypeIndication 0x40 = MPEG-4 Audio, streamType audio} >
+// DecoderSpecificInfo{the config}, then SLConfigDescriptor{predefined 2}.
+// Lengths in the 4-byte expandable form, as in an mp4 `esds` box.
+static void md_put_desc_len(std::vector<uint8_t>& v, uint32_t len) {
+    v.push_back((uint8_t)(0x80 | ((len >> 21) & 0x7f)));
+    v.push_back((uint8_t)(0x80 | ((len >> 14) & 0x7f)));
+    v.push_back((uint8_t)(0x80 | ((len >> 7) & 0x7f)));
+    v.push_back((uint8_t)(len & 0x7f));
+}
+static std::vector<uint8_t> md_esds_from_asc(const uint8_t* asc, int ascLen) {
+    std::vector<uint8_t> v;
+    if (!asc || ascLen <= 0) return v;
+    const uint32_t dsi = 1 + 4 + (uint32_t)ascLen;       // tag + length + config
+    const uint32_t dcd = 13 + dsi;                       // 13 fixed bytes + the DSI
+    const uint32_t es  = 3 + (1 + 4 + dcd) + (1 + 4 + 1);
+    v.push_back(0x03); md_put_desc_len(v, es);
+    v.push_back(0x00); v.push_back(0x01); v.push_back(0x00);   // ES_ID 1, no flags
+    v.push_back(0x04); md_put_desc_len(v, dcd);
+    v.push_back(0x40);                                   // MPEG-4 Audio
+    v.push_back(0x15);                                   // streamType audio, reserved bit
+    for (int i = 0; i < 3 + 4 + 4; ++i) v.push_back(0);  // bufferSizeDB, max/avg bitrate
+    v.push_back(0x05); md_put_desc_len(v, (uint32_t)ascLen);
+    v.insert(v.end(), asc, asc + ascLen);
+    v.push_back(0x06); md_put_desc_len(v, 1); v.push_back(0x02);
+    return v;
+}
