+    /** Native window-visibility observer (AppKit thread). */
+    public static void macapkWindowVisibility(final boolean visible) {
+        if (!BACKGROUND_WHEN_HIDDEN) return;
+        ownerHandler().post(new Runnable() {
+            @Override public void run() {
+                ownerHandler().removeCallbacks(sGoBackground);
+                if (!visible) {
+                    ownerHandler().postDelayed(sGoBackground, HIDDEN_GRACE_MS);
+                } else if (sWindowCover != null) {
+                    NativeLog.i(TAG, "window visible -> back to the foreground (onRestart/onStart/onResume)");
+                    SpecialAccessHandler.Cover c = sWindowCover;
+                    sWindowCover = null;
+                    try { NativeCocoa.setGuestBackgrounded(false); } catch (Throwable ignored) {}
+                    c.uncover();
+                }
+            }
+        });
+    }
