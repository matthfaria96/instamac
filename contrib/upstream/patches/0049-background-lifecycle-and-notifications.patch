+        com.macapk.loader.NativeLog.i("Notify", "clicked " + key + (n == null ? " (unknown)" : ""));
+        if (n == null) return;
+        new android.os.Handler(android.os.Looper.getMainLooper()).post(new Runnable() {
+            @Override public void run() {
+                if ((n.flags & Notification.FLAG_AUTO_CANCEL) != 0) {
+                    sPosted.remove(key);
+                    try { com.macapk.loader.NativeCocoa.removeHostNotification(key); } catch (Throwable ignored) {}
+                }
+                if (n.contentIntent != null) {
+                    try { n.contentIntent.send(); }
+                    catch (Throwable t) { com.macapk.loader.NativeLog.w("Notify", "contentIntent " + key + ": " + t); }
+                }
+            }
+        });
+    }
 
