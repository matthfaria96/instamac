diff --git a/runtime/src/host_notifications.mm b/runtime/src/host_notifications.mm
new file mode 100644
index 0000000..de314c8
--- /dev/null
+++ b/runtime/src/host_notifications.mm
@@ -0,0 +1,194 @@
+// host_notifications.mm -- the app's Android notifications in the macOS Notification
+// Center, through the notifier helper bundled at Contents/Helpers/InstamacNotifier.app
+// (the runtime executable is not a registered bundle, which UNUserNotificationCenter
+// requires). Protocol: tools/notifier/main.swift. ARC.
+//
+// NotificationManager.notify -> NativeCocoa.postHostNotification -> HostNotificationPost:
+// skipped while the app is in front with its window on screen (the app shows its own
+// in-app banner then), queued until the helper says it is ready, then posted as a
+// distributed notification. A click comes back as dev.instamac.notifier.clicked: the
+// window is brought to the front and NativeCocoa.macapkOnHostNotificationClicked fires
+// the notification's contentIntent. The Dock badge counts what is posted and not yet
+// cancelled; it clears when the app comes to the front.
+#import <Cocoa/Cocoa.h>
+#include <jni.h>
+#include <cstdio>
+#include <string>
+
+#include "macapk/cocoa_bridge.h"
+
+namespace {
+NSString* const kPost = @"dev.instamac.notifier.post";
+NSString* const kRemove = @"dev.instamac.notifier.remove";
+NSString* const kReady = @"dev.instamac.notifier.ready";
+NSString* const kClicked = @"dev.instamac.notifier.clicked";
+NSString* const kHelperId = @"dev.instamac.notifier";
+
+NSMutableArray<NSDictionary*>* g_queue;
+NSMutableSet<NSString*>* g_badge_keys;
+bool g_ready = false;
+bool g_launching = false;
+
+NSURL* helper_url() {
+    // .../Instamac.app/Contents/Resources/runtime/Resources/macapk-runtime
+    NSString* p = NSBundle.mainBundle.executablePath;
+    for (int i = 0; i < 4; i++) p = p.stringByDeletingLastPathComponent;   // -> Contents
+    return [NSURL fileURLWithPath:[p stringByAppendingPathComponent:@"Helpers/InstamacNotifier.app"]];
+}
+
+void send(NSString* name, NSDictionary* info) {
+    [NSDistributedNotificationCenter.defaultCenter postNotificationName:name object:nil
+                                                               userInfo:info deliverImmediately:YES];
+}
+
+void flush() {
+    for (NSDictionary* d in g_queue) send(d[@"name"], d[@"info"]);
+    [g_queue removeAllObjects];
+}
+
+void update_badge() {
+    NSUInteger n = g_badge_keys.count;
+    NSApp.dockTile.badgeLabel = n ? [NSString stringWithFormat:@"%lu", (unsigned long)n] : nil;
+}
+
+void notify_java_clicked(NSString* key) {
+    JavaVM* vm = nullptr;
+    jsize n = 0;
+    if (JNI_GetCreatedJavaVMs(&vm, 1, &n) != JNI_OK || n <= 0 || !vm) return;
+    JNIEnv* env = nullptr;
+    jint r = vm->GetEnv(reinterpret_cast<void**>(&env), JNI_VERSION_21);
+    if (r == JNI_EDETACHED) vm->AttachCurrentThread(reinterpret_cast<void**>(&env), nullptr);
+    if (!env) return;
+    static jclass cls = nullptr;
+    static jmethodID mid = nullptr;
+    if (!cls) {
+        jclass c = env->FindClass("com/macapk/loader/NativeCocoa");
+        if (!c) { env->ExceptionClear(); return; }
+        mid = env->GetStaticMethodID(c, "macapkOnHostNotificationClicked", "(Ljava/lang/String;)V");
+        if (!mid) { env->ExceptionClear(); env->DeleteLocalRef(c); return; }
+        cls = (jclass)env->NewGlobalRef(c);
+        env->DeleteLocalRef(c);
+    }
+    jstring k = env->NewStringUTF(key.UTF8String ?: "");
+    env->CallStaticVoidMethod(cls, mid, k);
+    if (env->ExceptionCheck()) { env->ExceptionDescribe(); env->ExceptionClear(); }
+    env->DeleteLocalRef(k);
+}
+
+NSWindow* main_window() {
+    NSWindow* best = nil;
+    for (NSWindow* w in NSApp.windows) {
+        if (!(w.styleMask & NSWindowStyleMaskTitled)) continue;
+        if (!best || w.frame.size.width * w.frame.size.height
+                     > best.frame.size.width * best.frame.size.height) best = w;
+    }
+    return best;
+}
+
+void install_once() {
+    static bool done = false;
+    if (done) return;
+    done = true;
+    g_queue = [NSMutableArray array];
+    g_badge_keys = [NSMutableSet set];
+    NSDistributedNotificationCenter* dnc = NSDistributedNotificationCenter.defaultCenter;
+    [dnc addObserverForName:kReady object:nil queue:NSOperationQueue.mainQueue
+                 usingBlock:^(NSNotification*) {
+        g_ready = true;
+        g_launching = false;
+        flush();
+    }];
+    [dnc addObserverForName:kClicked object:nil queue:NSOperationQueue.mainQueue
+                 usingBlock:^(NSNotification* note) {
+        NSString* key = note.userInfo[@"key"];
+        std::fprintf(stderr, "[notify] clicked %s\n", key.UTF8String ?: "?");
+        [NSApp unhide:nil];
+        if (NSWindow* w = main_window()) {
+            if (w.isMiniaturized) [w deminiaturize:nil];
+            [w makeKeyAndOrderFront:nil];
+        }
+        [NSApp activateIgnoringOtherApps:YES];
+        [g_badge_keys removeObject:key ?: @""];
+        update_badge();
+        notify_java_clicked(key);
+    }];
+    [NSNotificationCenter.defaultCenter addObserverForName:NSApplicationDidBecomeActiveNotification
+                                                    object:nil queue:NSOperationQueue.mainQueue
+                                                usingBlock:^(NSNotification*) {
+        [g_badge_keys removeAllObjects];
+        update_badge();
+    }];
+}
+
+void ensure_helper() {
+    if (g_ready) {
+        // It may have quit on its own since (a minute idle without Instamac).
+        if ([NSRunningApplication runningApplicationsWithBundleIdentifier:kHelperId].count) return;
+        g_ready = false;
+    }
+    if (g_launching) return;
+    NSURL* url = helper_url();
+    if (![NSFileManager.defaultManager fileExistsAtPath:url.path]) {
+        std::fprintf(stderr, "[notify] no helper at %s: notifications dropped\n", url.path.UTF8String);
+        [g_queue removeAllObjects];
+        return;
+    }
+    g_launching = true;
+    NSWorkspaceOpenConfiguration* cfg = [NSWorkspaceOpenConfiguration configuration];
+    cfg.activates = NO;
+    cfg.addsToRecentItems = NO;
+    [NSWorkspace.sharedWorkspace openApplicationAtURL:url configuration:cfg
+                                    completionHandler:^(NSRunningApplication* app, NSError* err) {
+        if (err) std::fprintf(stderr, "[notify] helper launch failed: %s\n",
+                              err.localizedDescription.UTF8String);
+        // An instance that was already running answers no "ready": post anyway after a
+        // moment; a duplicate post of the same key replaces itself in the Center.
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(1.5 * NSEC_PER_SEC)),
+                       dispatch_get_main_queue(), ^{
+            if (g_launching) { g_launching = false; g_ready = true; flush(); }
+        });
+    }];
+}
+
+void enqueue(NSString* name, NSDictionary* info) {
+    [g_queue addObject:@{ @"name": name, @"info": info }];
+    if (g_ready && [NSRunningApplication runningApplicationsWithBundleIdentifier:kHelperId].count) {
+        flush();
+    } else {
+        ensure_helper();
+    }
+}
+
+NSString* ns(const std::string& s) { return [NSString stringWithUTF8String:s.c_str()] ?: @""; }
+}  // namespace
+
+namespace macapk {
+
+void HostNotificationPost(const std::string& key, const std::string& title,
+                          const std::string& body, const std::string& thread) {
+    NSString* k = ns(key); NSString* t = ns(title); NSString* b = ns(body); NSString* th = ns(thread);
+    dispatch_async(dispatch_get_main_queue(), ^{
+        install_once();
+        NSWindow* w = main_window();
+        const bool in_front = NSApp.isActive && w && w.isVisible && !w.isMiniaturized
+            && (w.occlusionState & NSWindowOcclusionStateVisible);
+        std::fprintf(stderr, "[notify] post %s%s\n", k.UTF8String, in_front ? " (skipped: app in front)" : "");
+        if (in_front) return;
+        [g_badge_keys addObject:k];
+        update_badge();
+        enqueue(kPost, @{ @"key": k, @"title": t, @"body": b, @"thread": th });
+    });
+}
+
+void HostNotificationRemove(const std::string& key) {
+    NSString* k = ns(key);
+    dispatch_async(dispatch_get_main_queue(), ^{
+        install_once();
+        if (![g_badge_keys containsObject:k] && !g_ready) return;   // never posted this run
+        [g_badge_keys removeObject:k];
+        update_badge();
+        enqueue(kRemove, @{ @"key": k });
+    });
+}
+
+}  // namespace macapk
