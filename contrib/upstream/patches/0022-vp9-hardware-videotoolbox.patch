diff --git a/runtime/src/video_toolbox.mm b/runtime/src/video_toolbox.mm
--- a/runtime/src/video_toolbox.mm
+++ b/runtime/src/video_toolbox.mm
@@ -869,6 +869,88 @@ int macapk_vtb_probe_mime(const char* mimeC, int* outHw) {
 // Feeds one compressed access unit (may be null/0-length at eos with nothing
 // left to submit). Fire-and-forget: the decoded frame (if any) surfaces later
 // through macapk_vtb_poll. Returns 0 on success, negative on error.
+// VP9 through VideoToolbox, for video_vp9_decode.mm.
+//
+// The VP9 decoder is a SUPPLEMENTAL one: until the process registers it,
+// VTDecompressionSessionCreate answers -12906 for 'vp09'. That is the whole of
+// the "no decoder component on this host" finding in this file's header --
+// measured on an Apple M4, macOS 27.2, with a vpcC record: -12906 and
+// VTIsHardwareDecodeSupported = false before
+// VTRegisterSupplementalVideoDecoderIfAvailable(kCMVideoCodecType_VP9), noErr
+// with a hardware session after it. The stream's parameters come from the
+// keyframe the caller parsed; they go into the vpcC atom (VP Codec ISO Media
+// File Format Binding, "VPCodecConfigurationRecord"). A session that is not
+// hardware is refused: the caller's libvpx is the known software path.
+void* macapk_vtb_open_vp9(int width, int height, int profile, int bitDepth,
+                          int subsamplingX, int subsamplingY, int fullRange,
+                          int colorSpace, int* outHw) {
+    if (outHw) *outHw = 0;
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{
+        VTRegisterSupplementalVideoDecoderIfAvailable(kCMVideoCodecType_VP9);
+    });
+    if (width <= 0 || height <= 0) return nullptr;
+
+    // The lowest VP9 level whose luma picture size holds the frame.
+    static const struct { long samples; uint8_t level; } kLevels[] = {
+        { 36864, 10 }, { 73728, 11 }, { 122880, 20 }, { 245760, 21 }, { 552960, 30 },
+        { 983040, 31 }, { 2228224, 40 }, { 8912896, 50 }, { 35651584, 60 },
+    };
+    uint8_t level = 62;
+    for (const auto& l : kLevels) {
+        if ((long)width * height <= l.samples) { level = l.level; break; }
+    }
+    // 4:2:0 (colocated), 4:2:2 or 4:4:4, as the record numbers them.
+    const uint8_t chroma = (subsamplingX && subsamplingY) ? 1 : subsamplingX ? 2 : 3;
+    // VP9 color_space -> (primaries, transfer, matrix) code points; 2 = unspecified.
+    uint8_t cp = 2, tc = 2, mc = 2;
+    if (colorSpace == 1)      { cp = 6; tc = 6; mc = 6; }    // BT.601
+    else if (colorSpace == 2) { cp = 1; tc = 1; mc = 1; }    // BT.709
+    else if (colorSpace == 5) { cp = 9; tc = 1; mc = 9; }    // BT.2020
+    const uint8_t vpcC[12] = {
+        1, 0, 0, 0,                                     // version, flags
+        (uint8_t)profile, level,
+        (uint8_t)((bitDepth << 4) | (chroma << 1) | (fullRange ? 1 : 0)),
+        cp, tc, mc,
+        0, 0,                                           // no codec initialization data
+    };
+    CMVideoFormatDescriptionRef fmt = nullptr;
+    @autoreleasepool {
+        NSDictionary* extensions = @{
+            (id)kCMFormatDescriptionExtension_SampleDescriptionExtensionAtoms: @{
+                @"vpcC": [NSData dataWithBytes:vpcC length:sizeof vpcC],
+            },
+        };
+        OSStatus s = CMVideoFormatDescriptionCreate(
+            kCFAllocatorDefault, kCMVideoCodecType_VP9, width, height,
+            (__bridge CFDictionaryRef)extensions, &fmt);
+        if (s != noErr || !fmt) {
+            std::fprintf(stderr, "[video-toolbox] vp9: CMVideoFormatDescriptionCreate failed %d\n", (int)s);
+            return nullptr;
+        }
+    }
+    VtDecoder* d = new VtDecoder();
+    d->codecType = kCMVideoCodecType_VP9;
+    d->isAvcOrHevc = false;
+    d->fmtDesc = fmt;
+    d->width = width;
+    d->height = height;
+    bool hw = false;
+    d->session = CreateSessionInternal(fmt, /*refcon=*/d, &hw);
+    if (!d->session || !hw) {
+        if (d->session) {
+            VTDecompressionSessionInvalidate(d->session);
+            CFRelease(d->session);
+        }
+        CFRelease(d->fmtDesc);
+        delete d;
+        return nullptr;
+    }
+    d->usingHardware = true;
+    if (outHw) *outHw = 1;
+    return d;
+}
+
 int macapk_vtb_decode(void* h, const uint8_t* au, int auLen, int64_t ptsUs, int eos) {
     VtDecoder* d = (VtDecoder*)h;
     if (!d || !d->session) return -1;
