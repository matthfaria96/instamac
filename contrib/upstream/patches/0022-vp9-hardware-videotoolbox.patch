+struct Vp9KeyframeInfo {
+    int profile = 0, bitDepth = 8, colorSpace = 0, fullRange = 0;
+    int subsamplingX = 1, subsamplingY = 1;
+    int width = 0, height = 0;
+};
+
+// VP9 bitstream spec 6.2 (uncompressed_header): true when `au` starts with a
+// keyframe, with what its header says. In a superframe the first frame's
+// header is at the start of the buffer.
+bool ParseVp9Keyframe(const uint8_t* au, int auLen, Vp9KeyframeInfo* out) {
+    int bit = 0;
+    const int bits = auLen * 8;
+    auto read = [&](int n) -> int {
+        int v = 0;
+        for (int i = 0; i < n; i++, bit++) {
+            if (bit >= bits) return -1;
+            v = (v << 1) | ((au[bit >> 3] >> (7 - (bit & 7))) & 1);
+        }
+        return v;
+    };
+    if (read(2) != 2) return false;                         // frame_marker
+    const int profileLow = read(1), profileHigh = read(1);
+    out->profile = (profileHigh << 1) | profileLow;
+    if (out->profile == 3 && read(1) != 0) return false;    // reserved_zero
+    if (read(1) != 0) return false;                         // show_existing_frame
+    if (read(1) != 0) return false;                         // frame_type: 0 = KEY_FRAME
+    read(1);                                                // show_frame
+    read(1);                                                // error_resilient_mode
+    if (read(8) != 0x49 || read(8) != 0x83 || read(8) != 0x42) return false;   // frame_sync_code
+    out->bitDepth = 8;
+    if (out->profile >= 2) out->bitDepth = read(1) ? 12 : 10;
+    out->colorSpace = read(3);
+    if (out->colorSpace != 7) {                             // not CS_RGB
+        out->fullRange = read(1);
+        if (out->profile == 1 || out->profile == 3) {
+            out->subsamplingX = read(1);
+            out->subsamplingY = read(1);
+            read(1);                                        // reserved_zero
+        }
+    } else {
+        out->fullRange = 1;
+        out->subsamplingX = out->subsamplingY = 0;
+        if (out->profile == 1 || out->profile == 3) read(1);
+    }
+    const int w = read(16), h = read(16);                   // frame_width/height_minus_1
+    if (w < 0 || h < 0) return false;
+    out->width = w + 1;
+    out->height = h + 1;
+    return true;
+}
+
+bool Vp9HardwareWanted() {
+    static const bool wanted = [] {
+        const char* e = std::getenv("MACAPK_VP9_HW");
+        return !(e && e[0] == '0');
+    }();
+    return wanted;
+}
+
+// Open (or reopen) the VideoToolbox session when `au` is a keyframe whose
+// parameters are not the current session's. A refusal ends the attempts.
+void Vp9FollowKeyframe(Vp9Decoder* d, const uint8_t* au, int auLen) {
+    Vp9KeyframeInfo k;
+    if (!ParseVp9Keyframe(au, auLen, &k)) return;
+    if (d->vt && k.width == d->width && k.height == d->height
+            && k.profile == d->vtProfile && k.bitDepth == d->vtBitDepth) {
+        return;
+    }
+    if (d->vt) {
+        macapk_vtb_close(d->vt);
+        d->vt = nullptr;
+    }
+    int hw = 0;
+    d->vt = macapk_vtb_open_vp9(k.width, k.height, k.profile, k.bitDepth, k.subsamplingX,
+                                k.subsamplingY, k.fullRange, k.colorSpace, &hw);
+    if (!d->vt) {
+        d->vtAllowed = false;
+        std::fprintf(stderr, "[video-vp9] no hardware VideoToolbox session for %dx%d profile %d "
+                    "(%d-bit): staying on libvpx\n", k.width, k.height, k.profile, k.bitDepth);
+        return;
+    }
+    d->width = k.width;
+    d->height = k.height;
+    d->vtProfile = k.profile;
+    d->vtBitDepth = k.bitDepth;
+    std::fprintf(stderr, "[video-vp9] keyframe %dx%d profile %d (%d-bit): hw=YES (VideoToolbox)\n",
+                k.width, k.height, k.profile, k.bitDepth);
+}
+
