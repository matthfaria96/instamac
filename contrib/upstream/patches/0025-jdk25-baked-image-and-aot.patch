+            }
+            return -1;
+        case 'w':
+            if (create) {
+                predicate = has(UNICODE_CHARACTER_CLASS) ?
+                            CharPredicates.WORD() : CharPredicates.ASCII_WORD();
+                if (!inclass)
+                    root = newCharProperty(predicate);
+            }
