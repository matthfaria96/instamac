+        boolean inQuote = true;
+        boolean beginQuote = true;
+        while (i < pLen) {
+            int c = temp[i++];
+            if (!ASCII.isAscii(c) || ASCII.isAlpha(c)) {
+                newtemp[j++] = c;
+            } else if (ASCII.isDigit(c)) {
