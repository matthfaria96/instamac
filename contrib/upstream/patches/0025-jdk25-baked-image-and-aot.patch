+                case "script":
+                    p = CharPredicates.forUnicodeScript(value);
+                    break;
+                case "blk":
+                case "block":
+                    p = CharPredicates.forUnicodeBlock(value);
+                    break;
+                case "gc":
+                case "general_category":
+                    p = CharPredicates.forProperty(value, has(CASE_INSENSITIVE));
+                    break;
+                default:
+                    break;
+            }
