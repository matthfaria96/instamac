diff --git a/debug/StripModuleHashes.java b/debug/StripModuleHashes.java
new file mode 100644
--- /dev/null
+++ b/debug/StripModuleHashes.java
@@ -0,0 +1,20 @@
+// StripModuleHashes <module-info.class>: rewrite it without the ModuleHashes
+// attribute (java.lang.classfile, JDK 24+). Used by jdk25_bake.sh: java.base
+// records the hash of every module tied to it, so a jdk.unsupported with a baked
+// patch no longer matches; without the attribute jlink has nothing to compare.
+import java.lang.classfile.Attributes;
+import java.lang.classfile.ClassFile;
+import java.lang.classfile.ClassTransform;
+import java.nio.file.Files;
+import java.nio.file.Path;
+
+public class StripModuleHashes {
+    public static void main(String[] args) throws Exception {
+        Path p = Path.of(args[0]);
+        ClassFile cf = ClassFile.of();
+        byte[] out = cf.transformClass(cf.parse(Files.readAllBytes(p)),
+                ClassTransform.dropping(e -> e instanceof java.lang.classfile.attribute.ModuleHashesAttribute));
+        Files.write(p, out);
+        System.err.println("  stripped ModuleHashes from " + p);
+    }
+}
diff --git a/debug/jdk25_bake.sh b/debug/jdk25_bake.sh
new file mode 100644
--- /dev/null
+++ b/debug/jdk25_bake.sh
@@ -0,0 +1,112 @@
+#!/usr/bin/env bash
+# jdk25_bake.sh -- bake the runtime's --patch-module classes into a jlink image.
+#
+#   jdk25_bake.sh jmods  <jdk_home> <runtime_lib> <out_dir>
+#       For every patch directory the runtime would pass as --patch-module
+#       (<runtime_lib>/java_base_patch -> java.base, jdk_unsupported_patch ->
+#       jdk.unsupported), write <out_dir>/<module>.jmod: the JDK's own jmod with
+#       those classes laid over it. java.base is re-created last with its module
+#       hashes recomputed against the patched modules, or jlink refuses the image
+#       ("Hash of jdk.unsupported ... differs to expected hash recorded in
+#       java.base"). stage_jre.sh puts <out_dir> ahead of the JDK's jmods.
+#
+#   jdk25_bake.sh marker <runtime_lib>
+#       Print "<module> <sha256>" per patch directory, the digest
+#       jvm_loader.cpp PatchDirDigest computes (every regular file sorted by
+#       relative path, LC_ALL=C; "<relpath>\n<size>\n" then its bytes). The
+#       runtime drops a --patch-module flag only when its directory still has the
+#       digest the image was baked from, so a patch rebuilt after staging keeps
+#       its flag (and the AOT cache stays off for that run, loudly).
+#
+# Why this exists: HotSpot disables CDS / the AOT cache whenever any module is
+# patched, and the runtime always patches java.base and jdk.unsupported.
+set -euo pipefail
+
+module_of() {
+    case "$1" in
+        java_base_patch) echo java.base ;;
+        jdk_unsupported_patch) echo jdk.unsupported ;;
+        *) return 1 ;;
+    esac
+}
+
+digest() {
+    python3 - "$1" <<'PY'
+import hashlib, os, sys
+root = sys.argv[1]
+rel = []
+for d, _, files in os.walk(root):
+    for f in files:
+        p = os.path.join(d, f)
+        if os.path.isfile(p) and not os.path.islink(p):
+            rel.append(os.path.relpath(p, root))
+rel.sort(key=lambda s: s.encode())
+h = hashlib.sha256()
+for r in rel:
+    full = os.path.join(root, r)
+    h.update(("%s\n%d\n" % (r, os.path.getsize(full))).encode())
+    with open(full, "rb") as fh:
+        h.update(fh.read())
+print(h.hexdigest())
+PY
+}
+
+case "${1:-}" in
+marker)
+    LIB="${2:?usage: jdk25_bake.sh marker <runtime_lib>}"
+    echo "# module sha256-of-patch-dir (jvm_loader.cpp PatchDirDigest)"
+    for d in java_base_patch jdk_unsupported_patch; do
+        [ -d "$LIB/$d" ] || continue
+        echo "$(module_of "$d") $(digest "$LIB/$d")"
+    done
+    ;;
+jmods)
+    JDK="${2:?usage: jdk25_bake.sh jmods <jdk_home> <runtime_lib> <out_dir>}"
+    LIB="${3:?}"
+    OUT="${4:?}"
+    JMOD="$JDK/bin/jmod"
+    mkdir -p "$OUT"
+    WORK="$(mktemp -d "${TMPDIR:-/tmp}/macapk-bake.XXXXXX")"
+    trap 'rm -rf "$WORK"' EXIT
+    # extract <module> -> $WORK/<module>, overlay the patch classes
+    prepare() {
+        local mod="$1" patch="$2"
+        "$JMOD" extract --dir "$WORK/$mod" "$JDK/jmods/$mod.jmod"
+        (cd "$patch" && find . -type f -name '*.class' -print0 | while IFS= read -r -d '' f; do
+            mkdir -p "$WORK/$mod/classes/$(dirname "$f")"
+            cp "$f" "$WORK/$mod/classes/$f"
+        done)
+    }
+    # re-create a jmod from its extracted parts (only the sections it had)
+    create() {
+        local mod="$1"; shift
+        local args=(create --class-path "$WORK/$mod/classes")
+        [ -d "$WORK/$mod/lib" ] && args+=(--libs "$WORK/$mod/lib")
+        [ -d "$WORK/$mod/conf" ] && args+=(--config "$WORK/$mod/conf")
+        [ -d "$WORK/$mod/legal" ] && args+=(--legal-notices "$WORK/$mod/legal")
+        [ -d "$WORK/$mod/include" ] && args+=(--header-files "$WORK/$mod/include")
+        [ -d "$WORK/$mod/bin" ] && args+=(--cmds "$WORK/$mod/bin")
+        local ver
+        ver="$("$JDK/bin/java" --version | head -1 | awk '{print $2}')"
+        args+=(--module-version "$ver" --target-platform "$("$JMOD" describe "$JDK/jmods/$mod.jmod" | awk '/^platform/ {print $2}')")
+        rm -f "$OUT/$mod.jmod"
+        "$JMOD" "${args[@]}" "$@" "$OUT/$mod.jmod"
+    }
+    if [ -d "$LIB/jdk_unsupported_patch" ]; then
+        prepare jdk.unsupported "$LIB/jdk_unsupported_patch"
+        create jdk.unsupported
+    fi
+    prepare java.base "${LIB}/java_base_patch"
+    # java.base records the hashes of the modules tied to it, so the patched
+    # jdk.unsupported no longer matches, and `jmod --hash-modules` cannot
+    # recompute them (its own resolution fails on the old hash first). Drop the
+    # attribute instead: jlink then has nothing to compare.
+    "$JDK/bin/java" "$(dirname "$0")/StripModuleHashes.java" "$WORK/java.base/classes/module-info.class"
+    create java.base
+    echo "  baked: $(ls "$OUT")" >&2
+    ;;
+*)
+    echo "usage: jdk25_bake.sh jmods <jdk_home> <runtime_lib> <out_dir> | marker <runtime_lib>" >&2
+    exit 2
+    ;;
+esac
diff --git a/runtime/java_base_patch_jdk25/java/io/FileReader.java b/runtime/java_base_patch_jdk25/java/io/FileReader.java
new file mode 100644
--- /dev/null
+++ b/runtime/java_base_patch_jdk25/java/io/FileReader.java
@@ -0,0 +1,119 @@
+/*
+ * Mac.apk java.base overlay (--patch-module java.base). This REPLACES the JDK's
+ * java.io.FileReader. It is byte-for-byte the JDK 21 public API (five
+ * constructors delegating to a FileInputStream + the inherited InputStreamReader
+ * behaviour) with ONE addition: it redirects a read of the Linux procfs paths
+ * /proc/self/smaps and /proc/self/maps -- which do NOT exist on macOS -- to an
+ * in-memory synthesized body.
+ *
+ * WHY: macOS has no /proc, and our guest /proc synthesis lives in the Bionic
+ * open() shim, which the GUEST's native code routes through -- but a Java caller
+ * opens through libjava's own open(), which bypasses that shim entirely. There
+ * is no process-wide interpose (dyld does not apply a main-executable __interpose
+ * to a later-dlopen'd libjava) and no DYLD_INSERT entitlement, so the JVM read
+ * hit the absent real /proc. Instagram's page-size probe (X.0te) does
+ * `new FileReader("/proc/self/smaps")` and scans for a `KernelPageSize:` line; on
+ * failure it throws IllegalStateException("Could not get page size") ->
+ * ExceptionInInitializerError -> System.exit(10), which blocked the logged-in
+ * feed. This overlay makes that read succeed with the HOST page size (Apple
+ * Silicon = 16 kB, what the guest's native memory is actually laid out on). Only
+ * these two exact /proc/self paths are rewritten; every other file open is
+ * untouched, so ordinary Java file I/O is unchanged. Native /proc readers keep
+ * using the full live census through the Bionic shim.
+ *
+ * NO TEMP FILE (2026-09-24). The body used to be written to
+ * File.createTempFile("macapk_jvm_smaps", ".txt") with deleteOnExit(), and that
+ * hook never runs here: window close is _exit, harnesses SIGKILL, and HotSpot runs
+ * with -Xrs, under which JDK 21's Terminator says shutdown hooks run only through
+ * System.exit. So every JVM that read it leaked one file into the per-user TMPDIR
+ * (28 seen). A FileReader exposes no fd and no path, so serving the same ASCII
+ * bytes from a ByteArrayInputStream is invisible to every caller.
+ * See docs/procfs-synth-tmp-lifetime_2026-09-24.md.
+ */
+package java.io;
+
+import java.nio.charset.Charset;
+
+public class FileReader extends InputStreamReader {
+
+    public FileReader(String fileName) throws FileNotFoundException {
+        super(macapkOpen(fileName));
+    }
+
+    public FileReader(File file) throws FileNotFoundException {
+        super(macapkOpen(file));
+    }
+
+    public FileReader(FileDescriptor fd) {
+        super(new FileInputStream(fd));
+    }
+
+    public FileReader(String fileName, Charset charset) throws IOException {
+        super(macapkOpen(fileName), charset);
+    }
+
+    public FileReader(File file, Charset charset) throws IOException {
+        super(macapkOpen(file), charset);
+    }
+
+    // ---- Mac.apk /proc redirect (see the class comment) --------------------
+
+    // A minimal but well-formed smaps carrying exactly the fields a page-size
+    // probe scans. One synthetic mapping is enough: the probe reads the first
+    // KernelPageSize it finds. Pure ASCII, so the byte[] is built without going
+    // through a Charset.
+    private static final byte[] PROC_BODY = macapkAscii(
+          "0000000000000000-0000000000010000 r--p 00000000 00:00 0 \n"
+        + "Size:                 64 kB\n"
+        + "KernelPageSize:       16 kB\n"   // Apple Silicon host page size
+        + "MMUPageSize:          16 kB\n"
+        + "Rss:                   0 kB\n"
+        + "Pss:                   0 kB\n"
+        + "VmFlags: rd mr mw me \n");
+
+    private static byte[] macapkAscii(String s) {
+        byte[] b = new byte[s.length()];
+        for (int i = 0; i < b.length; i++) b[i] = (byte) s.charAt(i);
+        return b;
+    }
+
+    private static boolean macapkIsProc(String name) {
+        // Constant-first equals: a null name is NOT a /proc path, so it falls
+        // through to FileInputStream and throws the JDK's own NullPointerException.
+        return "/proc/self/smaps".equals(name) || "/proc/self/maps".equals(name);
+    }
+
+    // Any OTHER /proc path (2026-10-30): the runtime installs this hook
+    // (Boot, via reflection) to the bionic shim's /proc synthesis, so a Java
+    // read of e.g. /proc/self/status gets the same true per-process contents a
+    // native read does (Google Play services' memory metrics read it this way).
+    // Null outside the runtime, or for a path the shim does not answer: the
+    // open then proceeds exactly as the JDK's.
+    private static volatile java.util.function.UnaryOperator<String> macapkProcRemap;
+
+    private static String macapkRemap(String name) {
+        java.util.function.UnaryOperator<String> h = macapkProcRemap;
+        if (h == null || name == null || !name.startsWith("/proc/")) return name;
+        try {
+            String host = h.apply(name);
+            return host != null ? host : name;
+        } catch (Throwable t) {
+            return name;
+        }
+    }
+
+    private static InputStream macapkOpen(String fileName) throws FileNotFoundException {
+        if (macapkIsProc(fileName)) return new ByteArrayInputStream(PROC_BODY);
+        return new FileInputStream(macapkRemap(fileName));
+    }
+
+    private static InputStream macapkOpen(File file) throws FileNotFoundException {
+        if (file != null && macapkIsProc(file.getPath()))
+            return new ByteArrayInputStream(PROC_BODY);
+        if (file != null && file.getPath().startsWith("/proc/")) {
+            String host = macapkRemap(file.getPath());
+            if (!host.equals(file.getPath())) return new FileInputStream(host);
+        }
+        return new FileInputStream(file);
+    }
+}
