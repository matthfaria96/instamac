+    /**
+     * Parses inlined match flags and set them appropriately.
+     */
+    @SuppressWarnings("fallthrough")
+    private void addFlag() {
+        int ch = peek();
+        for (;;) {
+            switch (ch) {
+            case 'i':
+                flags0 |= CASE_INSENSITIVE;
+                break;
+            case 'm':
+                flags0 |= MULTILINE;
+                break;
+            case 's':
+                flags0 |= DOTALL;
+                break;
+            case 'd':
+                flags0 |= UNIX_LINES;
+                break;
+            case 'u':
+                flags0 |= UNICODE_CASE;
+                break;
+            case 'c':
+                flags0 |= CANON_EQ;
+                break;
+            case 'x':
+                flags0 |= COMMENTS;
+                break;
+            case 'U':
+                flags0 |= (UNICODE_CHARACTER_CLASS | UNICODE_CASE);
+                break;
+            case '-': // subFlag then fall through
+                ch = next();
+                subFlag();
+            default:
+                return;
+            }
+            ch = next();
+        }
+    }
