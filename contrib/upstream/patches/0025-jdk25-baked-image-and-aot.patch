+                matcher.hitEnd = true;
+                return false;
+            }
+            int guard = matcher.to - minLength;
+            for (; i <= guard; i++) {
+                if (next.match(matcher, i, seq)) {
+                    matcher.first = i;
+                    matcher.groups[0] = matcher.first;
+                    matcher.groups[1] = matcher.last;
+                    return true;
+                }
