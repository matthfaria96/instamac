+        case 'o':
+        case 'p':
+        case 'q':
+            break;
+        case 'r':
+            return '\r';
+        case 's':
+            if (create) {
+                predicate = has(UNICODE_CHARACTER_CLASS) ?
+                            CharPredicates.WHITE_SPACE() : CharPredicates.ASCII_SPACE();
+                if (!inclass)
+                    root = newCharProperty(predicate);
