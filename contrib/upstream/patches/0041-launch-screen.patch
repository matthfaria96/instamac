 // Re-center the placeholder window on its screen's visible frame on the NEXT
 // main-queue cycle. The window is aspect-ratio-locked, and AppKit shrinks an
@@ -3167,6 +3207,29 @@ static void MacapkSnapshotDc(const uint8_t* rgba, int w, int h) {
 // consumer (debug/rendercheck.sh, recap_*, sweep.sh) is unchanged. At worst a
 // busy app has retained a newer frame by the time the block runs, which no
 // consumer of the line distinguishes.
+// Whether the last presented frame (canvas or GL path) is more than one flat
+// colour, read on an 8x8 grid: an app's starting window is a solid fill, its first
+// real frame is not. The boot screen (launch_screen.mm) leaves on the first true.
+extern "C" bool CocoaLatestFrameHasContent(void) {
+    std::lock_guard<std::mutex> lk(g_snap_mu);
+    auto varied = [](const std::vector<uint8_t>& px, int w, int h) {
+        if (w <= 0 || h <= 0 || px.size() < (size_t)w * h * 4) return false;
+        const uint32_t* p = reinterpret_cast<const uint32_t*>(px.data());
+        uint32_t first = 0;
+        for (int gy = 0; gy < 8; gy++) {
+            for (int gx = 0; gx < 8; gx++) {
+                const uint32_t c = p[(size_t)((2 * gy + 1) * h / 16) * w + (2 * gx + 1) * w / 16]
+                                   & 0x00ffffffu;
+                if (gx == 0 && gy == 0) first = c;
+                else if (c != first) return true;
+            }
+        }
+        return false;
+    };
+    return varied(g_snap_canvas, g_snap_canvas_w, g_snap_canvas_h)
+        || varied(g_snap_dc, g_snap_dc_w, g_snap_dc_h);
+}
