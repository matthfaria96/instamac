+    // ---- MACAPK_DUMP_FRAGMENTS: the fragment tree, for a harness run ----------
+    // One line per fragment reachable from the activity: class, androidx state
+    // (Fragment.mState), max lifecycle, user-visible hint, whether it has a
+    // view. Answers "which fragment is the app holding back" when a screen
+    // stays empty with nothing in the log. Shape-based like the rest of this
+    // class: the manager's fragment list is whichever no-arg method returns a
+    // List of androidx Fragments (R8 renames getFragments).
+    private static final boolean DUMP_FRAGMENTS = System.getenv("MACAPK_DUMP_FRAGMENTS") != null;
+
+    public static void dumpTree(Activity activity) {
+        if (!DUMP_FRAGMENTS || activity == null) return;
+        try {
+            Object fm = getHostFragmentManager(activity);
+            if (fm == null) fm = callNoArg(activity, "getSupportFragmentManager");
+            StringBuilder sb = new StringBuilder("fragment tree of " + activity.getClass().getName());
+            dumpManager(fm, 1, sb);
+            NativeLog.i(TAG, sb.toString());
+        } catch (Throwable t) {
+            NativeLog.w(TAG, "fragment dump failed: " + t);
+        }
+    }
+
+    private static void dumpManager(Object fm, int depth, StringBuilder sb) {
+        if (fm == null || depth > 6) return;
+        for (Object f : fragmentsByShape(fm)) {
+            sb.append('\n');
+            for (int i = 0; i < depth; i++) sb.append("  ");
+            sb.append(f.getClass().getName())
+              .append(" state=").append(fragmentField(f, "mState"))
+              .append(" max=").append(fragmentField(f, "mMaxState"))
+              .append(" visibleHint=").append(fragmentField(f, "mUserVisibleHint"))
+              .append(" deferStart=").append(fragmentField(f, "mDeferStart"))
+              .append(" hidden=").append(fragmentField(f, "mHidden"))
+              .append(" view=").append(fragmentField(f, "mView") != null);
+            dumpManager(fragmentField(f, "mChildFragmentManager"), depth + 1, sb);
+        }
+    }
+
+    private static List<Object> fragmentsByShape(Object fm) {
+        List<Object> out = new ArrayList<>();
+        Class<?> fragment;
+        try {
+            fragment = Class.forName("androidx.fragment.app.Fragment", false, fm.getClass().getClassLoader());
+        } catch (Throwable notAndroidx) {
+            return out;
+        }
+        for (Class<?> c = fm.getClass(); c != null && c != Object.class; c = c.getSuperclass()) {
+            for (Method m : c.getDeclaredMethods()) {
+                if (m.getParameterCount() != 0 || m.getReturnType() != List.class
+                        || java.lang.reflect.Modifier.isStatic(m.getModifiers())) continue;
+                try {
+                    m.setAccessible(true);
+                    Object got = m.invoke(fm);
+                    if (!(got instanceof List) || ((List<?>) got).isEmpty()) continue;
+                    boolean all = true;
+                    for (Object o : (List<?>) got) all &= fragment.isInstance(o);
+                    if (!all) continue;
+                    out.addAll((List<?>) got);
+                    return out;
+                } catch (Throwable ignored) { }
+            }
+        }
+        return out;
+    }
+
+    private static Object fragmentField(Object fragment, String name) {
+        for (Class<?> c = fragment.getClass(); c != null && c != Object.class; c = c.getSuperclass()) {
+            try {
+                java.lang.reflect.Field f = c.getDeclaredField(name);
+                f.setAccessible(true);
+                return f.get(fragment);
+            } catch (NoSuchFieldException up) {
+                continue;
+            } catch (Throwable t) {
+                return null;
+            }
+        }
+        return null;
+    }
+
     private static Object callNoArg(Object target, String name) {
         if (target == null) return null;
         Method m = findNoArg(target.getClass(), name);
