+// ---- external textures (GL_OES_EGL_image_external) without the extension ----
+// ANGLE's Metal backend does not expose it, and SurfaceTexture already puts each
+// frame into the attached name as a GL_TEXTURE_2D (SurfaceTexture.java,
+// latchCameraFrameToGl). The consumer's half is uniform: its samplerExternalOES
+// shader has to compile -- as sampler2D, without the #extension line -- and its
+// GL_TEXTURE_EXTERNAL_OES binds and parameters have to reach that same 2D
+// texture instead of being GL_INVALID_ENUM (an error the frame upload's own
+// check then read as its own and gave up: "first camera-frame GL upload
+// reported error 0x500"). Instagram's camera preview is such a consumer.
+// MACAPK_GL_EXTERNAL_AS_2D=0 turns the mapping off.
+static constexpr int kTextureExternalOes = 0x8D65;
+static bool external_as_2d() {
+    static const bool on = [] {
+        const char* e = std::getenv("MACAPK_GL_EXTERNAL_AS_2D");
+        return !(e && e[0] == '0');
+    }();
+    return on;
+}
+static inline int tex_target(int target) {
+    return (target == kTextureExternalOes && external_as_2d()) ? 0x0DE1 /*GL_TEXTURE_2D*/ : target;
+}
+// The source with `samplerExternalOES` as `sampler2D` and the extension
+// directive blanked (the line stays, so compile errors keep their numbers).
+// Empty when the shader does not use external textures.
+static std::string external_shader_as_2d(const char* source) {
+    if (!external_as_2d() || !std::strstr(source, "samplerExternalOES")) return std::string();
+    std::string out(source);
+    static const char kSampler[] = "samplerExternalOES";
+    for (size_t at = 0; (at = out.find(kSampler, at)) != std::string::npos; at += 9) {
+        out.replace(at, sizeof kSampler - 1, "sampler2D");
+    }
+    for (size_t at = 0; (at = out.find("GL_OES_EGL_image_external", at)) != std::string::npos;) {
+        size_t line = out.rfind('\n', at);
+        line = line == std::string::npos ? 0 : line + 1;
+        size_t end = out.find('\n', at);
+        if (end == std::string::npos) end = out.size();
+        if (out.compare(line, 10, "#extension") == 0 || out.find("#extension", line) < at) {
+            out.replace(line, end - line, "");
+            at = line;
+        } else {
+            at = end;
+        }
+    }
+    return out;
+}
