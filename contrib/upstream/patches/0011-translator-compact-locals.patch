+    static int translateCompactLocals(DexMethod m, ClassFileWriter.MethodWriter mw,
+                                      DexType.ClassHierarchy hierarchy, InitRepointPlan plan,
+                                      SuperInterfacePlan superIfaces) {
+        final boolean was = COMPACT_LOCALS.get();
+        COMPACT_LOCALS.set(true);
+        try {
+            translate(m, mw, hierarchy, plan, superIfaces, false);
+            CodeWriter body = mw.code();
+            return body == null ? -1 : body.measuredLength();
+        } catch (CodeWriter.CodeLengthExceeded e) {
+            return e.length;
+        } finally {
+            COMPACT_LOCALS.set(was);
+        }
+    }
