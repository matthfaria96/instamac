+     *  the first symbols subset has it, and emoji otherwise -- which is what
+     *  makes a bare U+2764 a red heart on a device. -Subsetted2 (heart, sun,
+     *  snowflake, card suits...) exists for U+FE0E and must not win here. */
+    private static boolean emojiFamilyWins(int cp, int next, Font primary) {
+        if (primary == null || next == 0xFE0E || emojiBase() == null) return false;
+        if (primary.canDisplay(cp)) return false;
+        ensureBase();
+        ensureFallbacks();
