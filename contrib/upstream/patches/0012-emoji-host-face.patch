+    /** One emoji cluster rasterized for a given text size and device scale.
+     *  `image` is `scale` device pixels per text unit; its top-left corner goes
+     *  at pen + (dx, dy). */
+    public static final class EmojiImage {
+        public final java.awt.image.BufferedImage image;
+        public final float dx, dy, scale;
+        EmojiImage(java.awt.image.BufferedImage image, float dx, float dy, float scale) {
+            this.image = image; this.dx = dx; this.dy = dy; this.scale = scale;
+        }
+    }
+
+    private static final int EMOJI_IMAGE_CACHE = 384;
+    private static final long EMOJI_IMAGE_BYTES = 24L << 20;
+    private static final int EMOJI_IMAGE_MAX_PIXELS = 4 << 20;
+    private static final Object EMOJI_NONE = new Object();
+    private static final ConcurrentHashMap<String, Object> sEmojiImages =
+        new ConcurrentHashMap<>();
+    private static final java.util.concurrent.atomic.AtomicLong sEmojiImageBytes =
+        new java.util.concurrent.atomic.AtomicLong();
+
+    /** The cluster drawn with the host emoji face for text of this size, or
+     *  null when there is no such face (the caller keeps its old draw).
+     *
+     *  ⚠ AN IMAGE, NOT A GLYPH VECTOR, and not for speed. Measured on JDK 21 /
+     *  macOS: drawGlyphVector and drawString paint a colour glyph ONLY when
+     *  both the colour and the composite are fully opaque -- at any other
+     *  alpha they paint nothing at all (0 pixels, every destination type). A
+     *  secondary label at 60% black, or anything mid-fade, would lose its
+     *  emoji. Rasterizing opaque into an image and compositing the image is
+     *  the one route that honours alpha.
+     *
+     *  `deviceScale` is the scale the canvas maps text units to pixels with; it
+     *  is stepped to eighths so a scale animation reuses a handful of images
+     *  instead of one per frame. */
+    public static EmojiImage emojiImage(String cluster, float sizePx, float deviceScale) {
+        Font base = emojiBase();
+        if (base == null || cluster == null || cluster.isEmpty() || !(sizePx > 0f)) return null;
+        int step = Math.round(deviceScale * 8f);
+        if (step < 1) step = 1;
+        if (step > 64) step = 64;
+        String key = cluster + '\u0000' + Float.floatToIntBits(sizePx) + ':' + step;
+        Object v = sEmojiImages.get(key);
+        if (v == null) {
+            v = rasterEmoji(base, cluster, sizePx, step / 8f);
+            long bytes = (v instanceof EmojiImage)
+                ? 4L * ((EmojiImage) v).image.getWidth() * ((EmojiImage) v).image.getHeight() : 0L;
+            // Bounded both ways: an animated text size asks for a new entry
+            // every frame, and one story-sized emoji is hundreds of kilobytes.
+            if (sEmojiImages.size() >= EMOJI_IMAGE_CACHE
+                    || sEmojiImageBytes.get() + bytes > EMOJI_IMAGE_BYTES) {
+                sEmojiImages.clear();
+                sEmojiImageBytes.set(0L);
+            }
+            if (sEmojiImages.putIfAbsent(key, v) == null) sEmojiImageBytes.addAndGet(bytes);
+        }
+        return v == EMOJI_NONE ? null : (EmojiImage) v;
+    }
+
+    private static Object rasterEmoji(Font base, String cluster, float sizePx, float scale) {
+        try {
+            final float cell = emojiAdvance(sizePx);
+            final char[] cs = cluster.toCharArray();
+            float em = EMOJI_FACE_EM * sizePx;
+            java.awt.font.GlyphVector gv = null;
+            float w = 0f;
+            // A sequence this host does not ligate comes back as several
+            // glyphs; measureText charged ONE cell for the cluster, so the
+            // pieces are shrunk to share it rather than overrun the next run.
+            for (int pass = 0; pass < 2; pass++) {
+                gv = base.deriveFont(em * scale).layoutGlyphVector(
+                        TEXT_FRC, cs, 0, cs.length, Font.LAYOUT_LEFT_TO_RIGHT);
+                w = (float) gv.getLogicalBounds().getWidth() / scale;
+                if (!(w > 0f)) return EMOJI_NONE;
+                if (w <= cell) break;
+                em *= cell / w;
+            }
+            // The face inks up to 0.88 em above and 0.12 em below its baseline
+            // and stays inside its advance (measured); the margins cover that.
+            final float padX = 0.12f * em, above = 1.02f * em, below = 0.27f * em;
+            final int iw = (int) Math.ceil((w + 2f * padX) * scale);
+            final int ih = (int) Math.ceil((above + below) * scale);
+            if (iw <= 0 || ih <= 0 || (long) iw * ih > EMOJI_IMAGE_MAX_PIXELS) return EMOJI_NONE;
+            java.awt.image.BufferedImage img = new java.awt.image.BufferedImage(
+                    iw, ih, java.awt.image.BufferedImage.TYPE_INT_ARGB_PRE);
+            java.awt.Graphics2D ig = img.createGraphics();
+            try {
+                ig.setRenderingHint(java.awt.RenderingHints.KEY_TEXT_ANTIALIASING,
+                                    java.awt.RenderingHints.VALUE_TEXT_ANTIALIAS_ON);
+                ig.setColor(java.awt.Color.BLACK);
+                ig.drawGlyphVector(gv, padX * scale, above * scale);
+            } finally {
+                ig.dispose();
+            }
+            return new EmojiImage(img, (cell - w) * 0.5f - padX,
+                    EMOJI_FACE_CENTRE * em - EMOJI_CENTRE_EM * sizePx - above, scale);
+        } catch (Throwable t) {
+            return EMOJI_NONE;
+        }
+    }
