+    /** The host emoji face sized so one glyph advances exactly one emoji cell.
+     *  For callers that lay text out themselves (the bidi TextLayout path);
+     *  null when the host has no such face. */
+    public static Font emojiCellFont(float sizePx) {
+        Font base = emojiBase();
+        return (base == null || !(sizePx > 0f)) ? null : base.deriveFont(emojiAdvance(sizePx));
+    }
