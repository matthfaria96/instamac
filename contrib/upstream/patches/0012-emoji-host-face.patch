+    private static final boolean EMOJI_FACE =
+        !"0".equals(System.getenv("MACAPK_EMOJI_FACE"));
+    private static final String EMOJI_FAMILY = "Apple Color Emoji";
+    private static final float EMOJI_FACE_EM = 1.2f;
+    private static final float EMOJI_FACE_CENTRE = 0.38f;
+    private static final float EMOJI_CENTRE_EM = 0.34f;
+
+    private static volatile Font sEmojiBase;
+    private static volatile boolean sEmojiProbed;
+
+    private static Font emojiBase() {
+        if (!sEmojiProbed) {
+            synchronized (MacApkFont.class) {
+                if (!sEmojiProbed) {
+                    Font found = null;
+                    if (EMOJI_FACE) {
+                        try {
+                            // AWT answers an unknown family with Dialog rather
+                            // than failing, so the family has to be read back.
+                            Font c = new Font(EMOJI_FAMILY, Font.PLAIN, 1);
+                            if (EMOJI_FAMILY.equalsIgnoreCase(c.getFamily(java.util.Locale.ROOT))) found = c;
+                        } catch (Throwable ignored) {}
+                    }
+                    sEmojiBase = found;
+                    sEmojiProbed = true;
+                }
+            }
+        }
+        return sEmojiBase;
+    }
