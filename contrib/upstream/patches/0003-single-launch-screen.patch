 // it is safe from the JVM thread CocoaSetPhoneSizeMax runs on.
 // Bisect gate, shared with com.macapk.loader.DisplayConfig:
 // MACAPK_RESIZE_CONFIG=0 turns the whole v1.0.1637 display model off.
+// ---- Instamac: ONE screen for the whole launch ------------------------------
+//
+// MEASURED on a two-display Mac (2560x1440 + 1080x1920): the launch budget was
+// computed from [[NSScreen mainScreen] visibleFrame] (2560x1284pt) while the
+// window itself opened on the OTHER display (origin x = -1080, 1080x1890). The
+// app then ran with a Configuration describing one display and a surface of the
+// other -- the incoherence that feeds the libstartup/CacheKeyGenerator storm and
+// the corrupted state our supervisor has to recover from.
+//
+// [NSScreen mainScreen] is not a stable "the user's display": AppKit answers it
+// for the KEY window, so it flips as windows move. Pin it ONCE at launch -- the
+// screen under the mouse, else mainScreen, else the first -- and use that same
+// screen for the budget AND for the window frame.
+static NSScreen* g_launch_screen = nil;
+static NSScreen* macapk_launch_screen() {
+    if (g_launch_screen) return g_launch_screen;
+    @autoreleasepool {
+        NSPoint m = [NSEvent mouseLocation];
+        for (NSScreen* s in [NSScreen screens]) {
+            if (NSMouseInRect(m, [s frame], NO)) { g_launch_screen = s; break; }
+        }
+        if (!g_launch_screen) g_launch_screen = [NSScreen mainScreen];
+        if (!g_launch_screen) g_launch_screen = [[NSScreen screens] firstObject];
+    }
+    return g_launch_screen;
+}
