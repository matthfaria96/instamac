+// ---- scroll settings (the Rolagem menu) -----------------------------------------
+//
+// Speed multiplies the travel of the synthesized finger. Inertia picks whose
+// physics run once the fingers lift: the guest's own fling, or the macOS momentum
+// tail fed to the same finger. Both are kept in the user defaults. Auto-scroll
+// advances one screenful every N seconds while the user leaves the window alone;
+// it lasts for the session. MACAPK_SCROLL_SCALE / MACAPK_SCROLL_NO_MOMENTUM, when
+// set, still win for that run.
+static double g_scroll_speed = 1.0;
+static BOOL   g_scroll_host_inertia = NO;
+static double g_autoscroll_secs = 0.0;
+static void autoscroll_set(double secs);          // defined with the input view
+static void autoscroll_note_user_input(void);
+static void app_cache_clear_async(void);         // defined below, with the menu
+static NSString* const kScrollSpeedKey = @"ScrollSpeed";
+static NSString* const kScrollHostInertiaKey = @"ScrollHostInertia";
+static void scroll_settings_load(void) {
+    NSUserDefaults* d = [NSUserDefaults standardUserDefaults];
+    const double v = [d doubleForKey:kScrollSpeedKey];
+    g_scroll_speed = (v >= 0.25 && v <= 4.0) ? v : 1.0;
+    g_scroll_host_inertia = [d boolForKey:kScrollHostInertiaKey];
+    g_video_sound = [d objectForKey:kVideoSoundKey] ? [d integerForKey:kVideoSoundKey] : 1;
+    if (g_video_sound < 0 || g_video_sound > 2) g_video_sound = 1;
+    // MACAPK_DEBUG_CLEAR_CACHE=<secs>: clear the cache that long after launch.
+    if (const char* e = std::getenv("MACAPK_DEBUG_CLEAR_CACHE"); e && atof(e) > 0.0) {
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(atof(e) * NSEC_PER_SEC)),
+                       dispatch_get_main_queue(), ^{ app_cache_clear_async(); });
+    }
+    // MACAPK_AUTOSCROLL=<secs>: auto-scroll on from launch (an unattended run).
+    if (const char* e = std::getenv("MACAPK_AUTOSCROLL"); e && atof(e) > 0.0) {
+        const double secs = atof(e);
+        dispatch_async(dispatch_get_main_queue(), ^{ autoscroll_set(secs); });
+    }
+}
+static void scroll_settings_save(void) {
+    NSUserDefaults* d = [NSUserDefaults standardUserDefaults];
+    [d setDouble:g_scroll_speed forKey:kScrollSpeedKey];
+    [d setBool:g_scroll_host_inertia forKey:kScrollHostInertiaKey];
+}
+static double scroll_effective_speed(void) {
+    static const double pinned = [] {
+        const char* e = std::getenv("MACAPK_SCROLL_SCALE");
+        const double v = e ? atof(e) : 0.0;
+        return (v >= 0.05 && v <= 4.0) ? v : 0.0;
+    }();
+    return pinned > 0.0 ? pinned : g_scroll_speed;
+}
+
+enum { kMenuTagScrollSpeed = 1, kMenuTagScrollInertia = 2, kMenuTagAutoScroll = 3,
+       kMenuTagVideoSound = 4 };
