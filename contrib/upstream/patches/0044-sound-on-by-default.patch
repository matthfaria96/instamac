+// Visualizar: the two modes, the rotate shortcut, the mode's size.
+static void install_view_menu(NSMenu* mainMenu) {
+    NSMenu* menu = add_menu(mainMenu, @"Visualizar");
+    [menu setDelegate:g_view_menu_target];
+    g_view_menu_target.viewMenu = menu;
+    g_view_menu_target.portraitItem = add_item(menu, @"Celular — em pé", @selector(pickPortrait:),
+        @"1", NSEventModifierFlagCommand, g_view_menu_target);
+    g_view_menu_target.landscapeItem = add_item(menu, @"Tablet — deitado", @selector(pickLandscape:),
