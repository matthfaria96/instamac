+// ---- orientation (Retrato / Paisagem) and the fixed window size ---------------
+//
+// Owner decision: the window has TWO shapes and the user picks one from the
+// View menu, like turning a phone:
+//   Retrato   -- upright: the app sees a phone (500dp wide) and puts its
+//                navigation at the bottom;
+//   Paisagem  -- lying down: the app sees a wide display (1280dp) and puts its
+//                navigation on the side.
+// The shape itself is the window policy's box for the per-app preference
+// (portrait / default), so launch, Cmd+R and the menu all go through the same
+// decision and the app's Configuration always describes the window it is in.
+//
+// On top of that the window SIZE is fixed by default: no resize handle, no zoom
+// button, no fullscreen. The lock never chooses a size -- it pins whatever box
+// the policy gave the current orientation, and follows it on a rotation. The
+// menu can lift it, labelled as not recommended; the choice is remembered in
+// <android_root>/.macapk/resolution ("locked" / "free").
+namespace macapk {
+static void set_orientation_pref(bool portrait);
+static bool orientation_pref_is_portrait();
+}
+
+static BOOL g_size_locked = NO;
+
+static BOOL resolution_ui_on(void) {
+    static const BOOL on = [] {
+        const char* e = std::getenv("MACAPK_RESOLUTION_UI");
+        return (BOOL)(e && e[0] == '1');
+    }();
+    return on;
+}
+
+static BOOL resolution_locked(void) { return resolution_ui_on() && g_size_locked; }
+
+static NSString* resolution_path(void) {
+    const char* root = std::getenv("MACAPK_ANDROID_ROOT");
+    if (!root || !root[0]) return nil;
+    return [NSString stringWithFormat:@"%s/.macapk/resolution", root];
+}
+
+static void resolution_load(void) {
+    NSString* path = resolution_path();
+    NSString* mode = path ? [NSString stringWithContentsOfFile:path
+                                                      encoding:NSUTF8StringEncoding
+                                                         error:NULL] : nil;
+    mode = [mode stringByTrimmingCharactersInSet:
+                 [NSCharacterSet whitespaceAndNewlineCharacterSet]];
+    // Free unless the user locked it (View > Travar Tamanho da Janela).
+    g_size_locked = [mode isEqualToString:@"locked"];
+}
+
+static void resolution_save(void) {
+    NSString* path = resolution_path();
+    if (!path) return;
+    [[NSFileManager defaultManager] createDirectoryAtPath:[path stringByDeletingLastPathComponent]
+                              withIntermediateDirectories:YES attributes:nil error:NULL];
+    [(g_size_locked ? @"locked" : @"free") writeToFile:path atomically:YES
+                                              encoding:NSUTF8StringEncoding error:NULL];
+}
+
+// Pin (or release) the window at the content size it has NOW. Called once the
+// window exists and again after every reshape, so the pinned size is always the
+// policy's box for the current orientation. Never resizes the window: a resize
+// made here during boot is what once left the Android configuration describing
+// one size and the surface another.
+static void resolution_apply(NSWindow* w) {
+    if (!w || !resolution_ui_on()) return;
+    if (([w styleMask] & NSWindowStyleMaskFullScreen) != 0) return;   // AppKit owns it
+    NSWindowStyleMask mask = [w styleMask];
+    NSWindowCollectionBehavior behaviour = [w collectionBehavior];
+    NSButton* zoom = [w standardWindowButton:NSWindowZoomButton];
+    if (g_size_locked) {
+        const NSSize cur = [w contentRectForFrameRect:[w frame]].size;
+        mask &= ~NSWindowStyleMaskResizable;
+        behaviour &= ~NSWindowCollectionBehaviorFullScreenPrimary;
+        behaviour |= NSWindowCollectionBehaviorFullScreenNone;
+        [w setCollectionBehavior:behaviour];
+        [w setStyleMask:mask];
+        [w setContentMinSize:cur];
+        [w setContentMaxSize:cur];
+        [zoom setHidden:YES];
+    } else {
+        // Resizable, never fullscreen: the green button zooms inside the mode's
+        // limits.
+        mask |= NSWindowStyleMaskResizable;
+        behaviour &= ~NSWindowCollectionBehaviorFullScreenPrimary;
+        behaviour |= NSWindowCollectionBehaviorFullScreenNone;
+        [w setCollectionBehavior:behaviour];
+        [w setStyleMask:mask];
+        [zoom setHidden:NO];
+        [zoom setEnabled:YES];
+        window_mode_limits(w);
+    }
+}
+// Each mode stays what it is while the user resizes it. Android's line between
+// a phone and a tablet layout is 600dp of width (1dp = 1pt here): Retrato never
+// reaches it, Paisagem never drops near it. The side itself (taller than wide,
+// or wider than tall) is held by the policy's resize range.
+static void window_mode_limits(NSWindow* w) {
+    if (!w || !resolution_ui_on() || g_size_locked) return;
+    if (([w styleMask] & NSWindowStyleMaskFullScreen) != 0) return;
+    if (macapk::orientation_pref_is_portrait()) {
+        [w setContentMinSize:NSMakeSize(320, 480)];
+        [w setContentMaxSize:NSMakeSize(599, FLT_MAX)];
+    } else {
+        [w setContentMinSize:NSMakeSize(720, 480)];
+        [w setContentMaxSize:NSMakeSize(FLT_MAX, FLT_MAX)];
+    }
+}
+
+// A reshape is about to give the window another box: the pin must not hold the
+// old one against it. resolution_apply re-pins once the new frame is set.
+static void resolution_release_for_reshape(NSWindow* w) {
+    if (!w || !resolution_ui_on()) return;
+    [w setContentMinSize:NSMakeSize(1, 1)];
+    [w setContentMaxSize:NSMakeSize(FLT_MAX, FLT_MAX)];
+}
