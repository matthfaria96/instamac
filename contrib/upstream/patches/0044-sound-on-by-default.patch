+static NSMenu* add_menu(NSMenu* mainMenu, NSString* title) {
+    NSMenuItem* slot = [[NSMenuItem alloc] init];
+    [mainMenu addItem:slot];
+    NSMenu* menu = [[NSMenu alloc] initWithTitle:title];
+    [slot setSubmenu:menu];
+    return menu;
+}
+static NSMenuItem* add_item(NSMenu* menu, NSString* title, SEL action, NSString* key,
+                            NSEventModifierFlags mods, id target) {
+    NSMenuItem* it = [[NSMenuItem alloc] initWithTitle:title action:action keyEquivalent:key];
+    [it setKeyEquivalentModifierMask:mods];
+    [it setTarget:target];
+    [menu addItem:it];
+    return it;
+}
