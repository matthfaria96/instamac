--- a/runtime/src/cocoa_bridge.mm
+++ b/runtime/src/cocoa_bridge.mm
@@ -9891,12 +10301,727 @@ static void CocoaDispatchBack() {
     if (env->ExceptionCheck()) { env->ExceptionDescribe(); env->ExceptionClear(); }
 }
 
