+- (void)pickUiScale:(id)sender {
+    const long s = [[(NSMenuItem*)sender representedObject] longValue];
+    if (s == ui_scale_current()) return;
+    NSString* path = ui_scale_path();
+    if (!path) return;
+    [(s ? [NSString stringWithFormat:@"%ld\n", s] : @"auto\n") writeToFile:path atomically:YES
+                                                 encoding:NSUTF8StringEncoding error:NULL];
+    std::fprintf(stderr, "[I] cocoa: interface size %ld%% -> reopening\n", s);
+    // An empty restart-intents file: reopen through LaunchServices, like the Dock.
+    NSString* none = [[path stringByDeletingLastPathComponent] stringByAppendingPathComponent:@"restart_none"];
+    [@"" writeToFile:none atomically:YES encoding:NSUTF8StringEncoding error:NULL];
+    macapk::CocoaExitProcess(0, none.UTF8String);
+}
