+// ---- titlebar controls (owner design, 2026-11-13) ---------------------------------
+// No window title; three controls centered in the titlebar, each a small rounded
+// rectangle with a hairline border so it reads as clickable, brighter under the
+// pointer: Back, Rotate, Create (a menu of the Arquivo share targets).
+@interface MacApkTitlebarButton : NSButton
+@property (nonatomic) BOOL macapkHover;
+@end
+@implementation MacApkTitlebarButton
+- (BOOL)wantsUpdateLayer { return YES; }
+- (void)updateLayer {
+    __block CGColorRef fill = NULL, border = NULL;
+    [self.effectiveAppearance performAsCurrentDrawingAppearance:^{
+        NSColor* f = self.isHighlighted ? [NSColor.labelColor colorWithAlphaComponent:0.22]
+                   : self.macapkHover   ? [NSColor.labelColor colorWithAlphaComponent:0.14]
+                                        : [NSColor.labelColor colorWithAlphaComponent:0.06];
+        fill = CGColorRetain(f.CGColor);
+        border = CGColorRetain([NSColor.labelColor colorWithAlphaComponent:0.22].CGColor);
+    }];
+    self.layer.cornerRadius = 7;
+    self.layer.borderWidth = 1;
+    self.layer.backgroundColor = fill;
+    self.layer.borderColor = border;
+    CGColorRelease(fill);
+    CGColorRelease(border);
+}
+- (void)updateTrackingAreas {
+    for (NSTrackingArea* a in [[self.trackingAreas copy] autorelease]) [self removeTrackingArea:a];
+    [self addTrackingArea:[[[NSTrackingArea alloc] initWithRect:self.bounds
+        options:(NSTrackingMouseEnteredAndExited | NSTrackingActiveAlways | NSTrackingInVisibleRect)
+        owner:self userInfo:nil] autorelease]];
+    [super updateTrackingAreas];
+}
+- (void)mouseEntered:(NSEvent*)e { (void)e; self.macapkHover = YES; self.needsDisplay = YES; }
+- (void)mouseExited:(NSEvent*)e  { (void)e; self.macapkHover = NO;  self.needsDisplay = YES; }
+- (void)setHighlighted:(BOOL)h   { [super setHighlighted:h]; self.needsDisplay = YES; }
+@end
