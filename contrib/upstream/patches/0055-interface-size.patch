+// The image and video files of a drag, as file URLs.
+static NSArray<NSURL*>* share_dragged_files(id<NSDraggingInfo> info) {
+    return [info.draggingPasteboard readObjectsForClasses:@[ NSURL.class ] options:@{
+        NSPasteboardURLReadingFileURLsOnlyKey : @YES,
+        NSPasteboardURLReadingContentsConformToTypesKey : @[ UTTypeImage.identifier, UTTypeMovie.identifier ],
+    }] ?: @[];
+}
+
+// The image and video promises of a drag (Photos hands out promises, not files).
+static NSArray<NSFilePromiseReceiver*>* share_dragged_promises(id<NSDraggingInfo> info) {
+    NSMutableArray<NSFilePromiseReceiver*>* out = [NSMutableArray array];
+    for (NSFilePromiseReceiver* r in [info.draggingPasteboard
+             readObjectsForClasses:@[ NSFilePromiseReceiver.class ] options:nil]) {
+        for (NSString* identifier in r.fileTypes) {
+            UTType* type = [UTType typeWithIdentifier:identifier];
+            if ([type conformsToType:UTTypeImage] || [type conformsToType:UTTypeMovie]) {
+                [out addObject:r];
+                break;
+            }
+        }
+    }
+    return out;
+}
+
+// Have the promised files written, then call `done` on the main queue with them.
+static void share_receive_promises(NSArray<NSFilePromiseReceiver*>* promises,
+                                   void (^done)(NSArray<NSURL*>*)) {
+    NSURL* dir = macapk::HostShareNewDropDir();
+    if (!dir) return;
+    NSOperationQueue* queue = [[NSOperationQueue alloc] init];
+    queue.maxConcurrentOperationCount = 1;   // serializes the two captures below
+    NSMutableArray<NSURL*>* files = [NSMutableArray array];
+    __block NSUInteger pending = 0;
+    for (NSFilePromiseReceiver* r in promises) pending += r.fileNames.count;
+    if (!pending) return;
+    for (NSFilePromiseReceiver* r in promises) {
+        [r receivePromisedFilesAtDestination:dir options:@{} operationQueue:queue
+                                      reader:^(NSURL* url, NSError* err) {
+            if (url && !err) [files addObject:url];
+            if (--pending == 0) {
+                NSArray<NSURL*>* all = [files copy];
+                dispatch_async(dispatch_get_main_queue(), ^{ done(all); });
+            }
+        }];
+    }
+}
