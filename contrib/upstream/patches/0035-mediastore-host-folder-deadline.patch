+    // ---- host folders that never answer a listing --------------------------------
+    // A Mac folder can make opendir() wait indefinitely: a privacy-protected media
+    // library (~/Movies/TV, the TV app's; ~/Music/Music) waits for a consent nobody
+    // is shown, and a File Provider folder can wait for the network. One of them
+    // under the mapped Movies kept MediaStore's sync from ever returning, so every
+    // query behind it hung: Instagram's gallery probe (is_favorite) never answered
+    // and its gallery stayed empty (measured 2026-11-12: `ls ~/Movies/TV` hangs).
+    // The known libraries are skipped by path; any other folder is listed with a
+    // deadline (MACAPK_MEDIA_LIST_TIMEOUT_MS, 1500) and, if it misses it, skipped
+    // for the session (the listing thread is left to finish on its own).
+    private static final java.util.Set<String> sBlockedDirs =
+        java.util.concurrent.ConcurrentHashMap.newKeySet();
+    private static final java.util.concurrent.ExecutorService sLister =
+        java.util.concurrent.Executors.newCachedThreadPool(r -> {
+            Thread t = new Thread(r, "mediastore-list");
+            t.setDaemon(true);
+            return t;
+        });
+    private static final long LIST_TIMEOUT_MS = listTimeoutMs();
+    private static long listTimeoutMs() {
+        try {
+            String e = System.getenv("MACAPK_MEDIA_LIST_TIMEOUT_MS");
+            if (e != null) return Math.max(100L, Long.parseLong(e.trim()));
+        } catch (Throwable ignored) { }
+        return 1500L;
+    }
+    static boolean isProtectedHostLibrary(File dir) {
+        try {
+            String home = System.getProperty("user.home");
+            if (home == null) return false;
+            String p = dir.getCanonicalPath();
+            return p.equals(home + "/Movies/TV") || p.equals(home + "/Music/Music")
+                || p.equals(home + "/Music/iTunes");
+        } catch (Throwable t) {
+            return false;
+        }
+    }
+    static File[] listHostDir(File dir) {
+        final String key = dir.getAbsolutePath();
+        if (sBlockedDirs.contains(key)) return null;
+        if (isProtectedHostLibrary(dir)) {
+            if (sBlockedDirs.add(key)) {
+                com.macapk.loader.NativeLog.i(TAG, "scan: skipping " + key + " (privacy-protected media library)");
+            }
+            return null;
+        }
+        java.util.concurrent.Callable<File[]> list = dir::listFiles;
+        java.util.concurrent.Future<File[]> f = sLister.submit(list);
+        try {
+            return f.get(LIST_TIMEOUT_MS, java.util.concurrent.TimeUnit.MILLISECONDS);
+        } catch (java.util.concurrent.TimeoutException e) {
+            sBlockedDirs.add(key);
+            com.macapk.loader.NativeLog.w(TAG, "scan: skipping " + key + " -- listing did not answer in "
+                + LIST_TIMEOUT_MS + " ms (privacy-protected or provider-backed folder)");
+            return null;
+        } catch (Exception e) {
+            return null;
+        }
+    }
+
