+// ---- host share ---------------------------------------------------------------
+// Files dragged onto the window or chosen from the menu bar, on their way to one
+// of the app's share targets (DocumentPickerHandler.macapkOnHostShare). The guest
+// never opens the user's originals: each file is staged under the temporary
+// directory first -- an APFS clone, or a JPEG re-encode for an image format an
+// Android app does not expect (HEIC, TIFF, RAW) -- on a background queue, so a
+// slow volume or a macOS privacy prompt cannot stall the AppKit thread.
+
+static NSURL* shareRoot() {
+    return [[NSURL fileURLWithPath:NSTemporaryDirectory() isDirectory:YES]
+        URLByAppendingPathComponent:@"macapk-share" isDirectory:YES];
+}
+
+/** A fresh directory for one batch. Batches older than a day are removed here:
+ *  the app has long since read (and re-encoded) what it was given. */
+static NSURL* newShareDir(NSString* prefix) {
+    NSFileManager* fm = NSFileManager.defaultManager;
+    NSURL* root = shareRoot();
+    NSDate* cutoff = [NSDate dateWithTimeIntervalSinceNow:-86400];
+    for (NSURL* old in [fm contentsOfDirectoryAtURL:root
+                            includingPropertiesForKeys:@[ NSURLContentModificationDateKey ]
+                                               options:0 error:nil]) {
+        NSDate* modified = nil;
+        [old getResourceValue:&modified forKey:NSURLContentModificationDateKey error:nil];
+        if (modified && [modified compare:cutoff] == NSOrderedAscending) [fm removeItemAtURL:old error:nil];
+    }
+    NSURL* dir = [root URLByAppendingPathComponent:
+        [prefix stringByAppendingString:NSUUID.UUID.UUIDString] isDirectory:YES];
+    return [fm createDirectoryAtURL:dir withIntermediateDirectories:YES attributes:nil error:nil] ? dir : nil;
+}
+
+static bool needsJpeg(NSURL* src) {
+    UTType* type = [UTType typeWithFilenameExtension:src.pathExtension];
+    if (!type || ![type conformsToType:UTTypeImage]) return false;
+    for (UTType* native in @[ UTTypeJPEG, UTTypePNG, UTTypeGIF, UTTypeWebP ]) {
+        if ([type conformsToType:native]) return false;
+    }
+    return true;
+}
+
+/** Re-encode keeping the metadata (orientation included), colours converted to
+ *  sRGB: a Display P3 photo read by a decoder that ignores profiles looks washed out. */
+static bool writeJpeg(NSURL* src, NSURL* dst) {
+    CGImageSourceRef in = CGImageSourceCreateWithURL((__bridge CFURLRef) src, nullptr);
+    if (!in) return false;
+    bool ok = false;
+    CGImageDestinationRef out = CGImageDestinationCreateWithURL(
+        (__bridge CFURLRef) dst, (__bridge CFStringRef) UTTypeJPEG.identifier, 1, nullptr);
+    if (out) {
+        NSDictionary* opts = @{
+            (__bridge id) kCGImageDestinationLossyCompressionQuality : @0.92,
+            (__bridge id) kCGImageDestinationOptimizeColorForSharing : @YES,
+        };
+        CGImageDestinationAddImageFromSource(out, in, 0, (__bridge CFDictionaryRef) opts);
+        ok = CGImageDestinationFinalize(out);
+        CFRelease(out);
+    }
+    CFRelease(in);
+    return ok;
+}
+
+static NSArray<NSURL*>* stageForShare(NSArray<NSURL*>* urls) {
+    NSFileManager* fm = NSFileManager.defaultManager;
+    NSMutableArray<NSURL*>* staged = [NSMutableArray array];
+    NSURL* dir = newShareDir(@"");
+    if (!dir) return staged;
+    for (NSURL* src in urls) {
+        const bool jpeg = needsJpeg(src);
+        NSString* name = src.lastPathComponent;
+        if (jpeg) name = [[name stringByDeletingPathExtension] stringByAppendingPathExtension:@"jpg"];
+        NSURL* dst = [dir URLByAppendingPathComponent:name];
+        if ([fm fileExistsAtPath:dst.path]) {   // same name from two folders
+            dst = [dir URLByAppendingPathComponent:
+                [NSString stringWithFormat:@"%lu-%@", (unsigned long) staged.count, name]];
+        }
+        NSError* err = nil;
+        const bool ok = jpeg ? writeJpeg(src, dst) : [fm copyItemAtURL:src toURL:dst error:&err];
+        if (ok) {
+            [staged addObject:dst];
+        } else {
+            std::fprintf(stderr, "[W] share: could not stage %s (%s)\n", src.lastPathComponent.UTF8String,
+                         err ? err.localizedDescription.UTF8String : "not a readable image");
+        }
+    }
+    return staged;
+}
