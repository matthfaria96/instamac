+- (BOOL)performDragOperation:(id<NSDraggingInfo>)sender {
+    const NSPoint at = [self convertPoint:sender.draggingLocation fromView:nil];
+    // The menu opens after the drop has been answered: tracked from inside it,
+    // it would keep the drag's source waiting for the whole choice.
