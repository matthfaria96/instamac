+    private static final java.util.Map<String, Integer> MACAPK_HOST_CLICKS =
+        macapkParseHostClicks(System.getenv("MACAPK_HOST_CLICK"));
+
+    private static java.util.Map<String, Integer> macapkParseHostClicks(String spec) {
+        if (spec == null || spec.isEmpty()) return null;
+        java.util.HashMap<String, Integer> out = new java.util.HashMap<>();
+        for (String rule : spec.split(";")) {
+            int eq = rule.indexOf('=');
+            if (eq <= 0 || !rule.startsWith("id/")) continue;
+            try {
+                out.put(rule.substring(3, eq).trim(), Integer.parseInt(rule.substring(eq + 1).trim()));
+            } catch (NumberFormatException ignored) { }
+        }
+        return out.isEmpty() ? null : out;
+    }
