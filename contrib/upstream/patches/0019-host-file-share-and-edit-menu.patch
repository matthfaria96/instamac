+// ---- the app's cache (app menu > Limpar Cache…) ----------------------------------
+//
+// What Settings > Storage > Clear cache does on a device: the CONTENTS of every
+// package's cache/ and code_cache/ under the Android root. An app may lose them
+// at any moment and rebuilds what it needs; accounts, databases and preferences
+// live elsewhere and are not touched. `remove` NO only measures.
+static unsigned long long app_cache_sweep(BOOL remove, NSUInteger* files_out) {
+    const char* root = std::getenv("MACAPK_ANDROID_ROOT");
+    unsigned long long bytes = 0;
+    NSUInteger files = 0;
+    if (root && root[0]) {
+        NSFileManager* fm = [NSFileManager defaultManager];
+        NSString* data = [NSString stringWithFormat:@"%s/data/data", root];
+        NSArray<NSURLResourceKey>* keys = @[ NSURLIsRegularFileKey, NSURLTotalFileAllocatedSizeKey ];
+        for (NSString* pkg in [fm contentsOfDirectoryAtPath:data error:NULL]) {
+            for (NSString* sub in @[ @"cache", @"code_cache" ]) {
+                // cache/ may be a link out of the bundle (~/Library/Caches).
+                NSString* dir = [[[data stringByAppendingPathComponent:pkg]
+                    stringByAppendingPathComponent:sub] stringByResolvingSymlinksInPath];
+                NSDirectoryEnumerator<NSURL*>* e =
+                    [fm enumeratorAtURL:[NSURL fileURLWithPath:dir isDirectory:YES]
+                        includingPropertiesForKeys:keys options:0 errorHandler:nil];
+                for (NSURL* u in e) {
+                    NSNumber *regular = nil, *size = nil;
+                    [u getResourceValue:&regular forKey:NSURLIsRegularFileKey error:NULL];
+                    if (![regular boolValue]) continue;
+                    [u getResourceValue:&size forKey:NSURLTotalFileAllocatedSizeKey error:NULL];
+                    bytes += [size unsignedLongLongValue];
+                    ++files;
+                }
+                if (!remove) continue;
+                for (NSString* name in [fm contentsOfDirectoryAtPath:dir error:NULL])
+                    [fm removeItemAtPath:[dir stringByAppendingPathComponent:name] error:NULL];
+            }
+        }
+    }
+    if (files_out) *files_out = files;
+    return bytes;
+}
+static void app_cache_clear_async(void) {
+    dispatch_async(dispatch_get_global_queue(QOS_CLASS_UTILITY, 0), ^{
+        NSUInteger files = 0;
+        const unsigned long long bytes = app_cache_sweep(YES, &files);
+        std::fprintf(stderr, "[I] cocoa: cache cleared: %lu file(s), %.1f MB\n",
+                     (unsigned long)files, (double)bytes / 1048576.0);
+    });
+}
+
+// ---- sending Mac files to the app (Arquivo menu, files dropped on the window) -----
+// Each destination is one of the app's own share targets -- the activities another
+// app's share sheet starts on a device. document_picker.mm stages the files and
+// hands them to DocumentPickerHandler.macapkOnHostShare.
+namespace macapk {
+NSURL* HostShareNewDropDir();
+void HostShareFiles(NSArray<NSURL*>* urls, const char* image_cls, const char* video_cls,
+                    const char* many_cls);
+}
+
+namespace {
+struct ShareTarget {
+    NSString* __unsafe_unretained menu_title;   // Arquivo menu: opens the file panel
+    NSString* __unsafe_unretained drop_title;   // the menu shown where files are dropped
+    NSString* __unsafe_unretained key;
+    NSEventModifierFlags mods;
+    const char* image;                          // activity for one image,
+    const char* video;                          // for one video,
+    const char* many;                           // and for several items
+};
+const ShareTarget kShareTargets[] = {
+    { @"Nova Publicação…", @"Publicar no Feed", @"n", NSEventModifierFlagCommand,
+      "com.instagram.share.handleractivity.ShareHandlerActivity",
+      "com.instagram.share.handleractivity.ShareHandlerActivity",
+      "com.instagram.share.handleractivity.ShareHandlerActivityMultipleFeedAlias" },
+    { @"Novo Story…", @"Adicionar ao Story", @"n", NSEventModifierFlagCommand | NSEventModifierFlagShift,
+      "com.instagram.share.handleractivity.StoryShareHandlerActivity",
+      "com.instagram.share.handleractivity.StoryShareHandlerActivity",
+      "com.instagram.share.handleractivity.MultiStoryShareHandlerActivity" },
+    { @"Novo Reel…", @"Criar Reel", @"n", NSEventModifierFlagCommand | NSEventModifierFlagOption,
+      "com.instagram.share.handleractivity.ReelShareHandlerActivity",
+      "com.instagram.share.handleractivity.ReelShareHandlerActivity",
+      "com.instagram.share.handleractivity.ReelShareHandlerActivity" },
+    { @"Enviar por Mensagem…", @"Enviar por Mensagem", @"d", NSEventModifierFlagCommand,
+      "com.instagram.direct.share.handler.DirectExternalMediaShareActivityPhoto",
+      "com.instagram.direct.share.handler.DirectExternalMediaShareActivityVideo",
+      "com.instagram.direct.share.handler.DirectMultipleExternalMediaShareActivity" },
+};
+const NSInteger kShareTargetCount = sizeof(kShareTargets) / sizeof(kShareTargets[0]);
+}  // namespace
+
+static void share_send(NSArray<NSURL*>* urls, NSInteger target) {
+    if (target < 0 || target >= kShareTargetCount || !urls.count) return;
+    const ShareTarget& t = kShareTargets[target];
+    std::fprintf(stderr, "[I] cocoa: share %lu file(s) -> %s\n", (unsigned long)urls.count,
+                 t.drop_title.UTF8String);
+    macapk::HostShareFiles(urls, t.image, t.video, t.many);
+}
+
+// The file panel for one destination: the Arquivo menu, and the app's own create
+// button when MACAPK_HOST_CLICK hands it over (View.macapkHostClick).
+static void share_pick(NSInteger target) {
+    if (target < 0 || target >= kShareTargetCount) return;
+    NSOpenPanel* panel = [NSOpenPanel openPanel];
+    panel.canChooseFiles = YES;
+    panel.canChooseDirectories = NO;
+    panel.allowsMultipleSelection = YES;
+    panel.allowedContentTypes = @[ UTTypeImage, UTTypeMovie ];
+    panel.message = kShareTargets[target].drop_title;
+    panel.prompt = @"Enviar";
+    // The first panel of a run opens on Pictures; after that, wherever the user went.
+    static bool s_opened = false;
+    if (!s_opened) {
+        s_opened = true;
+        panel.directoryURL = [NSFileManager.defaultManager URLsForDirectory:NSPicturesDirectory
+                                                                  inDomains:NSUserDomainMask].firstObject;
+    }
+    [NSApp activateIgnoringOtherApps:YES];
+    [panel beginWithCompletionHandler:^(NSModalResponse r) {
+        if (r == NSModalResponseOK) share_send(panel.URLs, target);
+    }];
+}
+
+namespace macapk {
+bool HostSharePick(int target) {
+    if (target < 0 || target >= kShareTargetCount) return false;
+    std::fprintf(stderr, "[I] cocoa: host click -> file panel for %s\n",
+                 kShareTargets[target].drop_title.UTF8String);
+    dispatch_async(dispatch_get_main_queue(), ^{ share_pick(target); });
+    return true;
+}
