+void HostShareFiles(NSArray<NSURL*>* urls, const char* image_cls, const char* video_cls,
+                    const char* many_cls) {
+    using namespace docpicker;
+    if (!urls.count || !g_vm || !g_cls || !g_on_host_share) return;
+    const std::string image = image_cls, video = video_cls, many = many_cls;
+    dispatch_async(dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^{
+        NSArray<NSURL*>* staged = stageForShare(urls);
+        std::fprintf(stderr, "[I] share: %lu of %lu file(s) staged\n",
+                     (unsigned long) staged.count, (unsigned long) urls.count);
+        if (!staged.count) return;
+        // Back on the AppKit thread, which is already attached to the JVM.
+        dispatch_async(dispatch_get_main_queue(), ^{
+            JNIEnv* env = attachedEnv();
+            if (!env) return;
+            jclass str = env->FindClass("java/lang/String");
+            jobjectArray paths = env->NewObjectArray((jsize) staged.count, str, nullptr);
+            for (NSUInteger i = 0; i < staged.count; i++) {
+                jstring js = env->NewStringUTF(staged[i].path.UTF8String);
+                env->SetObjectArrayElement(paths, (jsize) i, js);
+                env->DeleteLocalRef(js);
+            }
+            jstring cls[3] = { env->NewStringUTF(image.c_str()), env->NewStringUTF(video.c_str()),
+                               env->NewStringUTF(many.c_str()) };
+            env->CallStaticVoidMethod(g_cls, g_on_host_share, paths, cls[0], cls[1], cls[2]);
+            if (env->ExceptionCheck()) { env->ExceptionDescribe(); env->ExceptionClear(); }
+            for (int i = 0; i < 3; i++) env->DeleteLocalRef(cls[i]);
+            env->DeleteLocalRef(paths);
+            env->DeleteLocalRef(str);
+        });
+    });
+}
