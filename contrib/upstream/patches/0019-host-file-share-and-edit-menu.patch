+    // ---- host share ---------------------------------------------------------
+    // Files the user dragged onto the window or chose from the menu bar, started
+    // on one of the app's own share targets as ACTION_SEND / ACTION_SEND_MULTIPLE
+    // -- what another app's share sheet does on a device. The paths are staged
+    // copies (document_picker.mm), served through HostDocumentsProvider with a
+    // read grant, exactly like a picked document.
+
+    /** JNI, from the AppKit thread. `imageCls` / `videoCls` take one item of that
+     *  kind, `manyCls` takes several; each is an activity or alias of this app. */
+    public static void macapkOnHostShare(String[] paths, String imageCls, String videoCls,
+                                         String manyCls) {
+        ActivityHost.macapkPostOnOwner(() -> hostShare(paths, imageCls, videoCls, manyCls));
+    }
+
+    private static void hostShare(String[] paths, String imageCls, String videoCls, String manyCls) {
+        final String pkg = ActivityHost.macapkOwnPackage();
+        java.util.ArrayList<Uri> uris = new java.util.ArrayList<>();
+        boolean allImages = true, allVideos = true;
+        String firstMime = null;
+        if (paths != null) {
+            for (String path : paths) {
+                File f = path == null ? null : new File(path);
+                if (f == null || !f.isFile()) continue;
+                String mime = HostDocumentsProvider.mimeOf(f);
+                if (!isMediaMime(mime)) continue;
+                if (firstMime == null) firstMime = mime;
+                allImages &= mime.startsWith("image/");
+                allVideos &= mime.startsWith("video/");
+                uris.add(HostDocumentsProvider.mint(f, false));
+            }
+        }
+        if (pkg == null || uris.isEmpty()) {
+            NativeLog.w(TAG, "share: nothing to send (" + (paths == null ? 0 : paths.length)
+                    + " path(s), none an image or a video)");
+            return;
+        }
+        final boolean many = uris.size() > 1;
+        final String cls = many ? manyCls : allVideos ? videoCls : imageCls;
+        // The type a share sheet sends: the item's own for one, the common
+        // family for several, any for a mix.
+        final String type = !many ? firstMime : allImages ? "image/*" : allVideos ? "video/*" : "*/*";
+        Intent send = new Intent(many ? Intent.ACTION_SEND_MULTIPLE : Intent.ACTION_SEND);
+        send.setComponent(new android.content.ComponentName(pkg, cls));
+        send.setType(type);
+        if (many) send.putParcelableArrayListExtra(Intent.EXTRA_STREAM, uris);
+        else send.putExtra(Intent.EXTRA_STREAM, uris.get(0));
+        // Intent.migrateExtraStreamToClipData: the streams are also the ClipData,
+        // which is what carries the grant.
+        ClipData clip = new ClipData(null, new String[] { type }, new ClipData.Item(uris.get(0)));
+        for (int i = 1; i < uris.size(); i++) clip.addItem(new ClipData.Item(uris.get(i)));
+        send.setClipData(clip);
+        send.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION | Intent.FLAG_ACTIVITY_NEW_TASK);
+        MacApkUriGrants.grantFromIntent(send);
+        NativeLog.i(TAG, "share: " + uris.size() + " item(s) " + type + " -> " + cls);
+        try {
+            ActivityHost.macapkNoteReferrer(send, SHARE_SENDER);
+            ActivityHost.macapkDeliverCrossApp(send, SHARE_SENDER);
+        } catch (Throwable t) {
+            NativeLog.w(TAG, "share: start of " + cls + " threw: " + t);
+        }
+    }
+
+    /** The host's file panel for share target {@code target} (the menu bar's
