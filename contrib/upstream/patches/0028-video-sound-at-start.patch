+
+// ---- Visualizar > Som dos Vídeos ao Abrir ------------------------------------------
+// How the app's videos start: 0 as the app decides, 1 with sound, 2 muted. Kept in
+// the user defaults and copied, before the JVM exists, into the variable
+// android.media.AudioManager reads (MACAPK_VIDEO_SOUND_AT_START, which wins when it
+// is set already); AudioManager sends it to the app as the volume rocker. A change
+// from the menu also goes to AudioManager at once (macapkSetVideoSoundAtStart).
+static NSString* const kVideoSoundKey = @"VideoSoundAtStart";
+static long g_video_sound = 0;
+__attribute__((constructor)) static void video_sound_env(void) {
+    if (std::getenv("MACAPK_VIDEO_SOUND_AT_START")) return;
+    Boolean ok = false;
+    const CFIndex v = CFPreferencesGetAppIntegerValue(CFSTR("VideoSoundAtStart"),
+                                                      kCFPreferencesCurrentApplication, &ok);
+    if (ok && (v == 1 || v == 2)) setenv("MACAPK_VIDEO_SOUND_AT_START", v == 1 ? "on" : "off", 0);
+}
+static void video_sound_send(long choice) {
+    JavaVM* vm = nullptr;
+    jsize n = 0;
+    if (JNI_GetCreatedJavaVMs(&vm, 1, &n) != JNI_OK || n <= 0 || !vm) return;
+    JNIEnv* env = nullptr;
+    if (vm->GetEnv(reinterpret_cast<void**>(&env), JNI_VERSION_21) == JNI_EDETACHED)
+        vm->AttachCurrentThread(reinterpret_cast<void**>(&env), nullptr);
+    if (!env) return;
+    jclass c = env->FindClass("android/media/AudioManager");
+    jmethodID m = c ? env->GetStaticMethodID(c, "macapkSetVideoSoundAtStart", "(I)V") : nullptr;
+    if (m) env->CallStaticVoidMethod(c, m, (jint) choice);
+    if (env->ExceptionCheck()) env->ExceptionClear();
+    if (c) env->DeleteLocalRef(c);
 }
 
