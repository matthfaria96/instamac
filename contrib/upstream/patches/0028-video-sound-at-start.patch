+    private static boolean macapkVolumeKey(int keyCode) {
+        try {
+            android.app.Activity act = com.macapk.loader.ActivityHost.macapkTopActivity();
+            if (act == null) return false;
+            long t = android.os.SystemClock.uptimeMillis();
+            boolean down = act.dispatchKeyEvent(new android.view.KeyEvent(t, t,
+                android.view.KeyEvent.ACTION_DOWN, keyCode, 0));
+            boolean up = act.dispatchKeyEvent(new android.view.KeyEvent(t, t + 40,
+                android.view.KeyEvent.ACTION_UP, keyCode, 0));
+            com.macapk.loader.NativeLog.i("AudioManager", "volume key " + keyCode + " -> "
+                + act.getClass().getSimpleName() + " handled=" + down + "/" + up);
+            return down || up;
+        } catch (Throwable t) {
+            com.macapk.loader.NativeLog.w("AudioManager", "volume key failed: " + t);
+            return false;
+        }
     }
 
