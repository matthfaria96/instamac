+// ---- auto-scroll (Rolagem > Rolagem Automática) ----------------------------------
+//
+// Every g_autoscroll_secs the window advances: a two-finger scroll through the
+// body a real one runs (macapkScrollAt), 45% of the view in 0.4s, released while
+// still moving at a gentle ~600pt/s. The release speed is the point: a finger
+// that stops before it lifts is "put it back" to a snapping pager (measured on
+// the Reels tab: a drag of 62% of the view released at rest returned to the same
+// video, three times out of three), while a list only coasts a little further on
+// it. It waits while the user is using the window: a real scroll, click or key
+// restarts the count and ends a step in flight.
+static NSTimer* g_autoscroll_tick = nil;
+static NSTimer* g_autoscroll_step = nil;
+static CFTimeInterval g_autoscroll_idle_since = 0;
+static int g_autoscroll_i = 0;
+static CGFloat g_autoscroll_travel = 0;
+static const int kAutoScrollSteps = 48;   // at 120 Hz
+
+static MacApkMetalView* autoscroll_view(NSPoint* at) {
+    NSWindow* w = macapk::g_placeholder_window;
+    NSView* cv = w ? [w contentView] : nil;
+    if (!cv || [w isMiniaturized] || ![w isVisible]) return nil;
+    const NSRect b = [cv bounds];
+    // The finger starts below the middle, clear of the bottom fifth (where a
+    // full-screen pager keeps its caption and buttons), and stays inside the view.
+    const CGFloat from_top = 0.72;
+    const NSPoint c = NSMakePoint(NSMidX(b), [cv isFlipped]
+        ? b.origin.y + from_top * b.size.height : b.origin.y + (1.0 - from_top) * b.size.height);
+    NSView* hit = [cv hitTest:[cv convertPoint:c toView:[cv superview]]];
+    while (hit && ![hit isKindOfClass:[MacApkMetalView class]]) hit = [hit superview];
+    if (!hit) return nil;
+    if (at) *at = [hit convertPoint:c fromView:cv];
+    return (MacApkMetalView*)hit;
+}
+
+static void autoscroll_end_step(void) {
+    if (!g_autoscroll_step) return;
+    [g_autoscroll_step invalidate];
+    g_autoscroll_step = nil;
+    [autoscroll_view(nullptr) macapkScrollLift];
+    g_autoscroll_idle_since = CACurrentMediaTime();
+}
+
+static void autoscroll_begin_step(void) {
+    NSPoint p;
+    MacApkMetalView* v = autoscroll_view(&p);
+    if (!v) return;
+    g_autoscroll_i = 0;
+    g_autoscroll_travel = -0.45 * [v bounds].size.height / (CGFloat)scroll_effective_speed();
+    std::fprintf(stderr, "[I] cocoa: auto-scroll step from (%.0f,%.0f), %.0fpt\n", p.x, p.y,
+                 (double)g_autoscroll_travel);
+    [v macapkScrollAt:p dx:0 dy:0 precise:YES phase:NSEventPhaseBegan momentumPhase:NSEventPhaseNone];
+    g_autoscroll_step = [NSTimer scheduledTimerWithTimeInterval:1.0 / 120.0 repeats:YES block:^(NSTimer* t) {
+        (void)t;
+        NSPoint q;
+        MacApkMetalView* mv = autoscroll_view(&q);
+        const int i = ++g_autoscroll_i;
+        if (!mv || i > kAutoScrollSteps) { autoscroll_end_step(); return; }
+        // 60% at constant speed (what the release keeps) + 40% eased.
+        auto pos = [](double x) { return 0.6 * x + 0.4 * x * x * (3.0 - 2.0 * x); };
+        const CGFloat d = g_autoscroll_travel * (CGFloat)(pos((double)i / kAutoScrollSteps)
+                                                        - pos((double)(i - 1) / kAutoScrollSteps));
+        [mv macapkScrollAt:q dx:0 dy:d precise:YES phase:NSEventPhaseChanged momentumPhase:NSEventPhaseNone];
+    }];
+}
+
+static void autoscroll_set(double secs) {
+    autoscroll_end_step();
+    [g_autoscroll_tick invalidate];
+    g_autoscroll_tick = nil;
+    g_autoscroll_secs = secs > 0.0 ? secs : 0.0;
+    std::fprintf(stderr, "[I] cocoa: auto-scroll %s (%.0fs)\n", g_autoscroll_secs > 0.0 ? "on" : "off",
+                 g_autoscroll_secs);
+    if (g_autoscroll_secs <= 0.0) return;
+    g_autoscroll_idle_since = CACurrentMediaTime();
+    g_autoscroll_tick = [NSTimer scheduledTimerWithTimeInterval:0.25 repeats:YES block:^(NSTimer* t) {
+        (void)t;
+        if (g_autoscroll_step || g_autoscroll_secs <= 0.0) return;
+        if (CACurrentMediaTime() - g_autoscroll_idle_since >= g_autoscroll_secs) autoscroll_begin_step();
+    }];
+}
+
+static void autoscroll_note_user_input(void) {
+    if (g_autoscroll_secs <= 0.0) return;
+    autoscroll_end_step();
+    g_autoscroll_idle_since = CACurrentMediaTime();
+}
