+// ---- the two window modes open at a device's size -------------------------------
+//
+// MACAPK_WINDOW_SIZE_PORTRAIT / MACAPK_WINDOW_SIZE_DEFAULT = <W>x<H>, points: the
+// content size the window takes when it enters that preference -- at launch, on
+// a rotation, and from View > Tamanho Padrão. The policy's own portrait box is
+// the display turned on its side (500x800 on a 1280x800 budget), which is no
+// device anyone holds; a phone is 412x915. The size is applied as the resize a
+// window manager makes (ApplyUserResize: the window becomes the display and the
+// box is re-resolved on it), chained onto the transition that picked the
+// preference, so the app is given one Configuration, not two. It is fitted to
+// the screen's content area with its shape kept.
+static bool mode_default_size(winpolicy::UserWindowPref pref, int* w, int* h) {
+    const char* e = std::getenv(pref == winpolicy::UserWindowPref::kPortrait
+                                    ? "MACAPK_WINDOW_SIZE_PORTRAIT" : "MACAPK_WINDOW_SIZE_DEFAULT");
+    int sw = 0;
+    if (!e || !*e || !winpolicy::ParseBudgetOverride(e, w, h, &sw) || *w <= 0 || *h <= 0) return false;
+    const CocoaContentBudget cb = CocoaQueryContentBudget();
+    if (cb.ok && (*w > cb.w_pt || *h > cb.h_pt)) {
+        const double k = std::min((double)cb.w_pt / *w, (double)cb.h_pt / *h);
+        *w = (int)std::floor(*w * k);
+        *h = (int)std::floor(*h * k);
+    }
+    return *w > 0 && *h > 0;
+}
+
+static winpolicy::LiveWindow with_mode_default_size(const winpolicy::LiveWindow& w) {
+    int dw = 0, dh = 0;
+    if (w.fullscreen || !mode_default_size(w.pref, &dw, &dh)) return w;
+    if (dw == w.win_w_pt && dh == w.win_h_pt) return w;
+    const winpolicy::LiveOutcome o =
+        winpolicy::ApplyUserResize(g_wp.traits, g_wp.settings, w, dw, dh);
+    if (o.change == winpolicy::LiveChange::kRefused) {
+        std::fprintf(stderr, "[I] cocoa: window mode size %dx%d not applied: %s\n", dw, dh, o.why.c_str());
+        return w;
+    }
+    std::fprintf(stderr, "[I] cocoa: window mode %s opens at %dx%d (the policy box was %dx%d)\n",
+                 winpolicy::UserPrefName(w.pref), o.next.win_w_pt, o.next.win_h_pt, w.win_w_pt, w.win_h_pt);
+    return o.next;
+}
