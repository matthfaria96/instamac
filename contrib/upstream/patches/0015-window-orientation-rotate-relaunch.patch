+@implementation MacApkViewMenuTarget
+- (void)pickPortrait:(id)sender  { (void)sender; macapk::set_orientation_pref(true); }
+- (void)pickLandscape:(id)sender { (void)sender; macapk::set_orientation_pref(false); }
+- (void)defaultSize:(id)sender   { (void)sender; macapk::window_default_size_main(); }
+- (void)toggleSizeLock:(id)sender {
+    (void)sender;
+    g_size_locked = !g_size_locked;
+    resolution_save();
+    resolution_apply(macapk::g_placeholder_window);
+    std::fprintf(stderr, "[I] cocoa: window size %s\n", g_size_locked ? "locked" : "free");
+}
+- (void)pickScrollSpeed:(id)sender {
+    g_scroll_speed = [[(NSMenuItem*)sender representedObject] doubleValue];
+    scroll_settings_save();
+    std::fprintf(stderr, "[I] cocoa: scroll speed %.2fx\n", g_scroll_speed);
+}
+- (void)pickScrollInertia:(id)sender {
+    g_scroll_host_inertia = [[(NSMenuItem*)sender representedObject] boolValue];
+    scroll_settings_save();
+    std::fprintf(stderr, "[I] cocoa: scroll inertia %s\n", g_scroll_host_inertia ? "macOS" : "guest");
+}
+- (void)pickAutoScroll:(id)sender {
+    autoscroll_set([[(NSMenuItem*)sender representedObject] doubleValue]);
+}
+- (void)goBack:(id)sender { (void)sender; CocoaDispatchBack(); }
+- (void)clearCache:(id)sender {
+    (void)sender;
+    NSUInteger files = 0;
+    const unsigned long long bytes = app_cache_sweep(NO, &files);
+    NSAlert* alert = [[NSAlert alloc] init];
+    [alert setMessageText:@"Limpar o cache?"];
+    [alert setInformativeText:[NSString stringWithFormat:
+        @"O cache ocupa %@ (%lu arquivos): vídeos e imagens já baixados. Sua conta, suas "
+        @"mensagens e seus ajustes não são apagados; o que for preciso é baixado de novo.",
+        [NSByteCountFormatter stringFromByteCount:(long long)bytes
+                                       countStyle:NSByteCountFormatterCountStyleFile],
+        (unsigned long)files]];
+    [alert addButtonWithTitle:@"Limpar Cache"];
+    [alert addButtonWithTitle:@"Cancelar"];
+    [NSApp activateIgnoringOtherApps:YES];
+    if ([alert runModal] == NSAlertFirstButtonReturn) app_cache_clear_async();
+}
+- (void)showAbout:(id)sender {
+    (void)sender;
+    [NSApp activateIgnoringOtherApps:YES];
+    [NSApp orderFrontStandardAboutPanelWithOptions:
+        @{ NSAboutPanelOptionApplicationName : (self.appTitle ?: @"") }];
+}
+// The checkmarks are read when a menu opens, so they are right whichever way the
+// setting last changed (menu, shortcut, or what was read at launch).
+- (void)menuNeedsUpdate:(NSMenu*)menu {
+    (void)menu;
+    const BOOL portrait = macapk::orientation_pref_is_portrait();
+    [self.portraitItem  setState:portrait ? NSControlStateValueOn : NSControlStateValueOff];
+    [self.landscapeItem setState:portrait ? NSControlStateValueOff : NSControlStateValueOn];
+    [self.lockItem setState:g_size_locked ? NSControlStateValueOn : NSControlStateValueOff];
+    for (NSMenuItem* it in [self.scrollMenu itemArray]) {
+        const double v = [[it representedObject] doubleValue];
+        BOOL on = NO;
+        switch ([it tag]) {
+            case kMenuTagScrollSpeed:   on = fabs(v - g_scroll_speed) < 0.01; break;
+            case kMenuTagScrollInertia: on = (v != 0.0) == (g_scroll_host_inertia != NO); break;
+            case kMenuTagAutoScroll:    on = fabs(v - g_autoscroll_secs) < 0.01; break;
+            default: continue;
+        }
+        [it setState:on ? NSControlStateValueOn : NSControlStateValueOff];
+    }
+}
+@end
