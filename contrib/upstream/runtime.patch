+                    head = createGroup(true);
+                    tail = root;
+                    head.next = expr(tail);
+                }
+            }
+        } else { // (xxx) a regular group
+            capturingGroup = true;
+            head = createGroup(false);
+            tail = root;
+            head.next = expr(tail);
+        }
