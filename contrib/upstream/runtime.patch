+                    // the branch to indicate to go "next" directly.
+                    node = null;
+                } else {
+                    // the "tail.next" of each atom goes to branchConn
+                    nodeTail.next = branchConn;
+                }
+                if (prev == branch) {
+                    branch.add(node);
+                } else {
+                    if (prev == end) {
+                        prev = null;
+                    } else {
